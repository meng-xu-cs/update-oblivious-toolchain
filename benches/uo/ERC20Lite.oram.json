  "diagnostics": [],
  "transformed_source": "function mint(address,uint256)(address owner, uint256 amount) {\n  map[1][owner] = (map_get(1, owner) Add amount) @ None\n}\n\nfunction approve(address,address,uint256)(address owner, address spender, uint256 amount) {\n  let key = keccak256(owner, spender)\n  map[2][key] = amount @ Some(\"true\")\n}\n\nfunction transfer(address,address,uint256)(address from, address to, uint256 amount) {\n  let fromBalance = map_get(1, from)\n  abort_if Not((fromBalance Gte amount))\n  map[1][from] = (fromBalance Sub amount) @ Some(\"true\")\n  map[1][to] = (map_get(1, to) Add amount) @ Some(\"true\")\n  return 1\n}\n\nfunction transferFrom(address,address,address,uint256)(address owner, address spender, address to, uint256 amount) {\n  let key = keccak256(owner, spender)\n  let allowance = map_get(2, key)\n  let fromBalance = map_get(1, owner)\n  abort_if Not((allowance Gte amount))\n  abort_if Not((fromBalance Gte amount))\n  map[2][key] = (allowance Sub amount) @ Some(\"true\")\n  map[1][owner] = (fromBalance Sub amount) @ Some(\"true\")\n  map[1][to] = (map_get(1, to) Add amount) @ Some(\"true\")\n  return 1\n}\n\nfunction balanceOf(address)(address owner) {\n  return map_get(1, owner)\n}\n\nfunction allowanceOf(address,address)(address owner, address spender) {\n  let key = keccak256(owner, spender)\n  return map_get(2, key)\n}",
