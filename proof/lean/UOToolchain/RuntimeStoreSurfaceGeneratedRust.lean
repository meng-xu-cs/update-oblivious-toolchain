namespace GenerateRuntimeStoreSurfaceRust

def joinSep (sep : String) : List String → String
  | [] => ""
  | x :: xs => xs.foldl (fun acc part => acc ++ sep ++ part) x

def generatedRust : String :=
  joinSep "\n"
    [ "// @generated by proof/lean/GenerateRuntimeStoreSurfaceRust.lean; do not edit by hand."
    , "// Re-run `lake build generateRuntimeStoreSurfaceRust` and then `.lake/build/bin/generateRuntimeStoreSurfaceRust` from proof/lean."
    , "#![allow(dead_code)]"
    , ""
    , "use anyhow::{bail, Result};"
    , "use chacha20poly1305::aead::AeadInPlace;"
    , "use chacha20poly1305::{ChaCha20Poly1305, KeyInit, Nonce, Tag};"
    , "use rand::rngs::OsRng;"
    , "use rand::RngCore;"
    , "use rand_chacha::ChaCha20Rng;"
    , "use std::fmt;"
    , "use uo_core::FixedBoxBuilder;"
    , "use zeroize::Zeroize;"
    , ""
    , "use super::{"
    , "    decode_nonzero_into, generated_sealed_encoded_len, write_nonzero_encoded, SEALED_MAGIC,"
    , "    SEALED_NONCE_BYTES, SEALED_TAG_BYTES,"
    , "};"
    , ""
    , "#[derive(PartialEq, Eq)]"
    , "pub struct StoreCipher {"
    , "    key: [u8; 32],"
    , "}"
    , ""
    , "struct WipeOnDrop<'a> {"
    , "    bytes: &'a mut [u8],"
    , "}"
    , ""
    , "impl WipeOnDrop<'_> {"
    , "    fn as_slice(&self) -> &[u8] {"
    , "        self.bytes"
    , "    }"
    , ""
    , "    fn as_mut_slice(&mut self) -> &mut [u8] {"
    , "        self.bytes"
    , "    }"
    , "}"
    , ""
    , "impl Drop for WipeOnDrop<'_> {"
    , "    fn drop(&mut self) {"
    , "        self.bytes.zeroize();"
    , "    }"
    , "}"
    , ""
    , "impl fmt::Debug for StoreCipher {"
    , "    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"
    , "        f.debug_struct(\"StoreCipher\")"
    , "            .field(\"key\", &\"<redacted>\")"
    , "            .finish()"
    , "    }"
    , "}"
    , ""
    , "impl Drop for StoreCipher {"
    , "    fn drop(&mut self) {"
    , "        self.key.zeroize();"
    , "    }"
    , "}"
    , ""
    , "fn zeroed_boxed_bytes(len: usize) -> Result<Box<[u8]>> {"
    , "    let mut bytes = FixedBoxBuilder::new(len);"
    , "    for _ in 0..len {"
    , "        bytes.push(0u8)?;"
    , "    }"
    , "    bytes.finish()"
    , "}"
    , ""
    , "fn checked_end(start: usize, len: usize) -> Option<usize> {"
    , "    start.checked_add(len)"
    , "}"
    , ""
    , "fn read_exact_range<'a>(bytes: &'a [u8], start: usize, len: usize) -> Option<&'a [u8]> {"
    , "    let end = checked_end(start, len)?;"
    , "    bytes.get(start..end)"
    , "}"
    , ""
    , "fn copy_exact_into(out: &mut [u8], input: &[u8]) -> Option<()> {"
    , "    if out.len() != input.len() {"
    , "        return None;"
    , "    }"
    , "    for (target, byte) in out.iter_mut().zip(input.iter()) {"
    , "        *target = *byte;"
    , "    }"
    , "    Some(())"
    , "}"
    , ""
    , "impl StoreCipher {"
    , "    #[cfg_attr(not(test), allow(dead_code))]"
    , "    fn sealed_encoded_len(payload_len: usize) -> usize {"
    , "        generated_sealed_encoded_len(payload_len)"
    , "    }"
    , ""
    , "    pub fn from_rng<R: RngCore>(rng: &mut R) -> Self {"
    , "        let mut key = [0u8; 32];"
    , "        rng.fill_bytes(&mut key);"
    , "        Self { key }"
    , "    }"
    , ""
    , "    pub fn random() -> Self {"
    , "        let mut rng = OsRng;"
    , "        Self::from_rng(&mut rng)"
    , "    }"
    , ""
    , "    pub fn clone_for_runtime_state(&self) -> Self {"
    , "        Self { key: self.key }"
    , "    }"
    , ""
    , "    pub fn seal_and_wipe_boxed("
    , "        &self,"
    , "        aad: &[u8],"
    , "        payload: &mut [u8],"
    , "        rng: &mut ChaCha20Rng,"
    , "    ) -> Result<Box<[u8]>> {"
    , "        self::seal_and_wipe_boxed(self, aad, payload, rng)"
    , "    }"
    , ""
    , "    pub fn seal_and_wipe_into_slice("
    , "        &self,"
    , "        aad: &[u8],"
    , "        payload: &mut [u8],"
    , "        rng: &mut ChaCha20Rng,"
    , "        out: &mut [u8],"
    , "    ) -> bool {"
    , "        self::seal_and_wipe_into_slice(self, aad, payload, rng, out)"
    , "    }"
    , ""
    , "    pub fn filler_boxed(&self, aad: &[u8], len: usize, rng: &mut ChaCha20Rng) -> Result<Box<[u8]>> {"
    , "        self::filler_boxed(self, aad, len, rng)"
    , "    }"
    , ""
    , "    pub fn with_opened_payload<T>("
    , "        &self,"
    , "        aad: &[u8],"
    , "        payload_len: usize,"
    , "        encoded: &[u8],"
    , "        f: impl FnOnce(&[u8]) -> T,"
    , "    ) -> Option<T> {"
    , "        self::with_opened_payload(self, aad, payload_len, encoded, f)"
    , "    }"
    , "}"
    , ""
    , "pub(super) fn seal_and_wipe_boxed("
    , "    cipher: &StoreCipher,"
    , "    aad: &[u8],"
    , "    payload: &mut [u8],"
    , "    rng: &mut ChaCha20Rng,"
    , ") -> Result<Box<[u8]>> {"
    , "    let mut encoded = zeroed_boxed_bytes(generated_sealed_encoded_len(payload.len()))?;"
    , "    let sealed = seal_and_wipe_into_slice(cipher, aad, payload, rng, &mut encoded);"
    , "    if !sealed {"
    , "        bail!(\"exact-size sealed output buffer did not fit\");"
    , "    }"
    , "    Ok(encoded)"
    , "}"
    , ""
    , "pub(super) fn seal_and_wipe_into_slice("
    , "    cipher: &StoreCipher,"
    , "    aad: &[u8],"
    , "    payload: &mut [u8],"
    , "    rng: &mut ChaCha20Rng,"
    , "    out: &mut [u8],"
    , ") -> bool {"
    , "    let mut payload = WipeOnDrop { bytes: payload };"
    , "    let required_len = generated_sealed_encoded_len(payload.as_slice().len());"
    , "    if out.len() != required_len {"
    , "        return false;"
    , "    }"
    , "    let mut nonce_bytes = [0u8; SEALED_NONCE_BYTES];"
    , "    rng.fill_bytes(&mut nonce_bytes);"
    , "    let Ok(cipher_impl) = ChaCha20Poly1305::new_from_slice(&cipher.key) else {"
    , "        return false;"
    , "    };"
    , "    let Ok(tag) = cipher_impl.encrypt_in_place_detached("
    , "        Nonce::from_slice(&nonce_bytes),"
    , "        aad,"
    , "        payload.as_mut_slice(),"
    , "    ) else {"
    , "        return false;"
    , "    };"
    , "    let mut cursor = 0usize;"
    , "    if !write_nonzero_encoded(out, &mut cursor, &SEALED_MAGIC) {"
    , "        return false;"
    , "    }"
    , "    if !write_nonzero_encoded(out, &mut cursor, &nonce_bytes) {"
    , "        return false;"
    , "    }"
    , "    if !write_nonzero_encoded(out, &mut cursor, payload.as_slice()) {"
    , "        return false;"
    , "    }"
    , "    if !write_nonzero_encoded(out, &mut cursor, tag.as_slice()) {"
    , "        return false;"
    , "    }"
    , "    if cursor != out.len() {"
    , "        return false;"
    , "    }"
    , "    true"
    , "}"
    , ""
    , "pub(super) fn filler_boxed("
    , "    cipher: &StoreCipher,"
    , "    aad: &[u8],"
    , "    len: usize,"
    , "    rng: &mut ChaCha20Rng,"
    , ") -> Result<Box<[u8]>> {"
    , "    let mut filler = zeroed_boxed_bytes(len)?;"
    , "    seal_and_wipe_boxed(cipher, aad, &mut filler, rng)"
    , "}"
    , ""
    , "fn open_boxed("
    , "    cipher: &StoreCipher,"
    , "    aad: &[u8],"
    , "    payload_len: usize,"
    , "    encoded: &[u8],"
    , ") -> Option<Box<[u8]>> {"
    , "    let sealed_len = SEALED_MAGIC.len() + SEALED_NONCE_BYTES + payload_len + SEALED_TAG_BYTES;"
    , "    let mut sealed = zeroed_boxed_bytes(sealed_len).ok()?;"
    , "    decode_nonzero_into(encoded, &mut sealed)?;"
    , "    let magic = read_exact_range(&sealed, 0, SEALED_MAGIC.len())?;"
    , "    if magic != SEALED_MAGIC {"
    , "        return None;"
    , "    }"
    , "    let nonce_start = SEALED_MAGIC.len();"
    , "    let ciphertext_start = checked_end(nonce_start, SEALED_NONCE_BYTES)?;"
    , "    let tag_start = checked_end(ciphertext_start, payload_len)?;"
    , "    let nonce_bytes = read_exact_range(&sealed, nonce_start, SEALED_NONCE_BYTES)?;"
    , "    let ciphertext = read_exact_range(&sealed, ciphertext_start, payload_len)?;"
    , "    let tag_bytes = read_exact_range(&sealed, tag_start, SEALED_TAG_BYTES)?;"
    , "    let mut payload = zeroed_boxed_bytes(payload_len).ok()?;"
    , "    copy_exact_into(&mut payload, ciphertext)?;"
    , "    let cipher_impl = ChaCha20Poly1305::new_from_slice(&cipher.key).ok()?;"
    , "    cipher_impl"
    , "        .decrypt_in_place_detached("
    , "            Nonce::from_slice(nonce_bytes),"
    , "            aad,"
    , "            &mut payload,"
    , "            Tag::from_slice(tag_bytes),"
    , "        )"
    , "        .ok()?;"
    , "    Some(payload)"
    , "}"
    , ""
    , "pub(super) fn with_opened_payload<T>("
    , "    cipher: &StoreCipher,"
    , "    aad: &[u8],"
    , "    payload_len: usize,"
    , "    encoded: &[u8],"
    , "    f: impl FnOnce(&[u8]) -> T,"
    , ") -> Option<T> {"
    , "    let mut payload = open_boxed(cipher, aad, payload_len, encoded)?;"
    , "    let payload = WipeOnDrop {"
    , "        bytes: &mut payload,"
    , "    };"
    , "    Some(f(payload.as_slice()))"
    , "}"
    , ""
    ]

end GenerateRuntimeStoreSurfaceRust
