def RuntimeImplementationInterface.runtimeOwnsBridgeModules
  (iface : RuntimeImplementationInterface) : Prop :=
  sourceContainsAll iface.runtimeEvmLibSource ["mod runtime;"] ∧
    sourceLacksAll iface.runtimeEvmLibSource ["mod shell;", "mod theorem;"] ∧
    sourceContainsAll iface.runtimeModuleProductionSource
      [ "mod shell;"
      , "mod theorem;"
      , "theorem::run_traced_call("
      , "shell::run_public_entrypoint("
      ] ∧
    sourceLacksAll iface.runtimeModuleProductionSource
      ["pub(crate) mod theorem;", "pub(crate) mod shell;"]

def RuntimeImplementationInterface.checkRuntimeOwnsBridgeModules
  (iface : RuntimeImplementationInterface) : Bool :=
  checkSourceContainsAll iface.runtimeEvmLibSource ["mod runtime;"] &&
    checkSourceLacksAll iface.runtimeEvmLibSource ["mod shell;", "mod theorem;"] &&
    checkSourceContainsAll iface.runtimeModuleProductionSource
      [ "mod shell;"
      , "mod theorem;"
      , "theorem::run_traced_call("
      , "shell::run_public_entrypoint("
      ] &&
    checkSourceLacksAll iface.runtimeModuleProductionSource
      ["pub(crate) mod theorem;", "pub(crate) mod shell;"]

@[simp] theorem runtimeImplementationInterface_checkRuntimeOwnsBridgeModules_eq_true_iff
  (iface : RuntimeImplementationInterface) :
  iface.checkRuntimeOwnsBridgeModules = true ↔ iface.runtimeOwnsBridgeModules := by
  unfold RuntimeImplementationInterface.checkRuntimeOwnsBridgeModules
    RuntimeImplementationInterface.runtimeOwnsBridgeModules
  simp [and_assoc]

def RuntimeImplementationInterface.engineDelegatesToRuntimeBridge
  (iface : RuntimeImplementationInterface) : Prop :=
  sourceContainsAll iface.engineProductionSource
    ["state: ContractRuntime", "run_contract_call("] ∧
    sourceLacksAll iface.engineProductionSource
      [ "run_traced_call("
      , "run_public_entrypoint("
      , "run_confidential_entrypoint("
      , "prepare_confidential_entrypoint("
      , "AllocatorPlan::from_manifest("
      , "PublicRuntimeKernel::begin("
      , "ConfidentialCallInputs"
      , "RuntimeKernelRefinementEventWitness"
      , "RuntimeControllerObserverCertificate"
      , "RuntimePathOramHiddenCertificate"
      , "RuntimeTrustedKernelBundle"
      , "ExecutionTrace {"
      , "impl Clone for ContractInstance"
      , "state: self.state.clone()"
      ] ∧
    -- A call's result carries the receipt in every build and the whole
    -- trace only in a test or diagnostics build; no engine function returns
    -- a trace.
    sourceContainsAll iface.engineProductionSource
      [ "#[cfg(not(any(test, feature = \"diagnostics\")))]\n    pub receipt: PublicReceipt,"
      , "#[cfg(any(test, feature = \"diagnostics\"))]\n    pub trace: ExecutionTrace,"
      , "#[cfg(not(any(test, feature = \"diagnostics\")))]\n            receipt: trace.into_receipt(),"
      ] ∧
    sourceLacksAll iface.engineProductionSource
      [ "-> Result<ExecutionTrace>"
      , "-> ExecutionTrace"
      , "pub aborted: bool,\n    pub trace: ExecutionTrace,"
      ] ∧
    -- The receipt has the observer's fields and no other, the evidence and
    -- the trace are written out only by a test or diagnostics build, the
    -- evidence is wiped on drop, and nothing hands it out.
    sourceContainsAll iface.traceProductionSource
      [ "pub struct PublicReceipt {\n    #[serde(default)]\n    pub opcode_trace: Box<[String]>,\n    #[serde(default)]\n    pub logical_accesses: LogicalAccesses,\n    #[serde(default)]\n    pub logical_writes: Box<[LogicalEvent]>,\n    #[serde(default)]\n    pub physical_reads: PhysicalReads,\n    #[serde(default)]\n    pub physical_writes: PhysicalWrites,\n    #[serde(default)]\n    pub gas_used: u64,\n    #[serde(default)]\n    pub theorem_trace: TheoremTrace,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub public_state_transition: Option<RuntimePublicStateTransition>,\n}"
      , "#[derive(PartialEq, Default)]\n#[cfg_attr(\n    any(test, feature = \"diagnostics\"),\n    derive(Debug, Serialize, Deserialize)\n)]\npub struct PrivateEvidence {"
      , "#[derive(Debug, PartialEq, Default)]\n#[cfg_attr(any(test, feature = \"diagnostics\"), derive(Serialize, Deserialize))]\npub struct ExecutionTrace {\n    #[cfg_attr(any(test, feature = \"diagnostics\"), serde(flatten))]\n    pub receipt: PublicReceipt,\n    #[cfg_attr(any(test, feature = \"diagnostics\"), serde(flatten))]\n    pub(crate) evidence: PrivateEvidence,\n}"
      , "impl Drop for PrivateEvidence {\n    fn drop(&mut self) {\n        self.wipe();\n    }\n}"
      , "pub fn into_receipt(self) -> PublicReceipt {\n        self.receipt\n    }"
      -- A call that recorded no hidden ORAM state, as every production
      -- call, builds no proof bundle, which would carry the position maps,
      -- and runs the checks of its evidence that need none.
      , "pub fn unwitnessed() -> Self {\n        Self {\n            runtime_state_before: None,\n        }\n    }"
      , "let runtime_oram_position_maps_unrecorded = runtime_witness_state.is_none();"
      , "trace.check_evidence_without_position_maps(artifact, confidential)?;\n        } else {\n            if confidential {\n                trace.runtime_confidential_proof_bundle_family(artifact)?;\n            }\n            trace.materialize_runtime_trusted_kernel_bundle()?;\n        }\n        Ok(trace)"
      , "validate_path_oram_leaf_schedule(\n            &self.evidence.runtime_oram_leaf_schedule,\n            &refinement_trace.logical_accesses,\n            &refinement_trace.physical_reads,\n            &refinement_trace.physical_writes,\n            &self.evidence.runtime_oram_objects,\n        )?;\n        validate_refinement_outcome("
      , "if confidential {\n            self.check_runtime_confidential_kernel_bundles(artifact)?;\n        }\n        Ok(())"
      ] ∧
    sourceLacksAll iface.traceProductionSource
      [ "pub evidence: PrivateEvidence"
      , "pub fn evidence("
      , "-> PrivateEvidence"
      , "&PrivateEvidence"
      , "pub runtime_oram_"
      ]

