  , "        }"
  , "    }"
  , ""
  , "    pub(crate) fn require_injected() -> Self {"
  , "        Self::Injected {"
  , "            coins: Box::<[usize]>::default(),"
  , "            next_index: 0,"
  , "        }"
  , "    }"
  , ""
  , "    pub(crate) fn install(&mut self, coins: Box<[usize]>) {"
  , "        *self = Self::Injected {"
  , "            coins,"
  , "            next_index: 0,"
  , "        };"
  , "    }"
  , ""
  , "    pub(crate) fn take_leaf("
  , "        &mut self,"
  , "        object_id: u32,"
  , "        object_name: &str,"
  , "        access_counter: u64,"
  , "        leaf_count: usize,"
  , "        rng: &mut ChaCha20Rng,"
  , "    ) -> Result<usize> {"
  , "        match self {"
  , "            Self::Random { seed, next_index } => {"
  , "                let leaf = derive_path_oram_leaf("
  , "                    seed,"
  , "                    object_id,"
  , "                    object_name,"
  , "                    access_counter,"
  , "                    *next_index,"
  , "                    leaf_count,"
  , "                )?;"
  , "                *next_index = next_index.checked_add(1).ok_or_else(|| {"
  , "                    anyhow!(\"path ORAM fresh-leaf counter overflow for {object_name}\")"
  , "                })?;"
  , "                let _ = rng;"
  , "                Ok(leaf)"
  , "            }"
  , "            Self::Injected { coins, next_index } => {"
  , "                let leaf = coins.get(*next_index).copied().ok_or_else(|| {"
  , "                    anyhow!("
  , "                        \"path ORAM object {} requires injected fresh-leaf coins, but the tape is exhausted\","
  , "                        object_name"
  , "                    )"
  , "                })?;"
  , "                *next_index += 1;"
  , "                if leaf >= leaf_count.max(1) {"
  , "                    bail!("
  , "                        \"path ORAM object {} received injected leaf {} outside leaf count {}\","
  , "                        object_name,"
  , "                        leaf,"
  , "                        leaf_count.max(1)"
  , "                    );"
  , "                }"
  , "                Ok(leaf)"
  , "            }"
  , "        }"
  , "    }"
  , ""
  , "    pub(crate) fn ensure_exhausted(&self, object_name: &str) -> Result<()> {"
  , "        match self {"
  , "            Self::Random { .. } => Ok(()),"
  , "            Self::Injected { coins, next_index } if *next_index == coins.len() => Ok(()),"
  , "            Self::Injected { coins, next_index } => bail!("
  , "                \"path ORAM object {} left {} injected fresh-leaf coins unused\","
  , "                object_name,"
  , "                coins.len() - *next_index"
  , "            ),"
  , "        }"
  , "    }"
  , ""
  , "    /// Before commit an injected tape may still hold the coins of the writes"
  , "    /// pending until commit, `coins_per_write` per write, and no more: two on"
  , "    /// the local scheme (each write is one put access, which draws the miss"
  , "    /// leaf and the next leaf), and a put's node accesses on the private"
  , "    /// scheme's tree. A tape that is short fails when the commit draws from"
  , "    /// it."
  , "    pub(crate) fn ensure_reserved_for_writes("
  , "        &self,"
  , "        object_name: &str,"
  , "        pending_writes: usize,"
  , "        coins_per_write: usize,"
  , "    ) -> Result<()> {"
  , "        let reserved = pending_writes"
  , "            .checked_mul(coins_per_write)"
  , "            .ok_or_else(|| anyhow!(\"path ORAM object {object_name} has too many pending writes\"))?;"
  , "        match self {"
  , "            Self::Random { .. } => Ok(()),"
  , "            Self::Injected { coins, next_index } if coins.len() - *next_index <= reserved => Ok(()),"
  , "            Self::Injected { coins, next_index } => bail!("
  , "                \"path ORAM object {} left {} injected fresh-leaf coins unused\","
  , "                object_name,"
  , "                coins.len() - *next_index - reserved"
  , "            ),"
  , "        }"
  , "    }"
  , "}"
  , ""
  , "pub(super) fn surrogate_access_transcript("
  , "    state: &OramState,"
  , "    spec: &StateObject,"
  , ") -> Result<OramTranscript> {"
  , "    if state.storage.directory_pages.len() != state.parameters.metadata_pages {"
  , "        bail!("
  , "            \"surrogate ORAM transcript directory page count {} mismatched public bound {} for {}\","
  , "            state.storage.directory_pages.len(),"
  , "            state.parameters.metadata_pages,"
  , "            spec.name"
  , "        );"
  , "    }"
  , "    if state.storage.buckets.len() != state.parameters.bucket_count {"
  , "        bail!("
  , "            \"surrogate ORAM transcript bucket count {} mismatched public bound {} for {}\","
  , "            state.storage.buckets.len(),"
  , "            state.parameters.bucket_count,"
  , "            spec.name"
  , "        );"
  , "    }"
  , "    let public_access_count ="
  , "        1 + state.storage.directory_pages.len() + state.parameters.buckets_per_access;"
  , "    let mut logical_accesses = FixedBoxBuilder::new(public_access_count);"
  , "    let mut physical_reads = FixedBoxBuilder::new(public_access_count);"
  , ""
  , "    logical_accesses.push(LogicalEvent {"
  , "        kind: \"uooram_counter\".into(),"
  , "        object: spec.name.clone(),"
  , "        detail: \"counter\".into(),"
  , "    })?;"
  , "    physical_reads.push(PhysicalReadEvent {"
  , "        object: spec.name.clone(),"
  , "        location: format!(\"{}@counter\", spec.name),"
  , "        len: state.storage.access_counter_slot.len(),"
  , "    })?;"
  , ""
  , "    for page in 0..state.storage.directory_pages.len() {"
  , "        let directory_page = state.storage.directory_pages.get(page).ok_or_else(|| {"
  , "            anyhow!("
  , "                \"surrogate ORAM transcript directory page index {} missing despite public count guard for {}\","
  , "                page,"
  , "                spec.name"
  , "            )"
  , "        })?;"
  , "        logical_accesses.push(LogicalEvent {"
  , "            kind: \"uooram_meta_scan\".into(),"
  , "            object: spec.name.clone(),"
  , "            detail: format!(\"page:{page}\"),"
  , "        })?;"
  , "        physical_reads.push(PhysicalReadEvent {"
  , "            object: spec.name.clone(),"
  , "            location: format!(\"{}@meta{page}\", spec.name),"
  , "            len: directory_page.len(),"
  , "        })?;"
  , "    }"
  , ""
  , "    let bucket_count = state.storage.buckets.len();"
  , "    if bucket_count != 0 {"
  , "        for offset in 0..state.parameters.buckets_per_access {"
  , "            let index = ((state.access_counter as usize) + offset) % bucket_count;"
  , "            let bucket = state.storage.buckets.get(index).ok_or_else(|| {"
  , "                anyhow!("
  , "                    \"surrogate ORAM transcript bucket index {} missing despite public count guard for {}\","
  , "                    index,"
  , "                    spec.name"
  , "                )"
  , "            })?;"
  , "            logical_accesses.push(LogicalEvent {"
  , "                kind: \"uooram_bucket_scan\".into(),"
  , "                object: spec.name.clone(),"
  , "                detail: format!(\"bucket:{index}\"),"
  , "            })?;"
  , "            physical_reads.push(PhysicalReadEvent {"
  , "                object: spec.name.clone(),"
  , "                location: format!(\"{}@bucket{index}\", spec.name),"
  , "                len: bucket.len(),"
  , "            })?;"
  , "        }"
  , "    }"
  , ""
  , "    Ok(OramTranscript {"
  , "        logical_accesses: logical_accesses.finish()?,"
  , "        physical_reads: physical_reads.finish()?,"
  , "        physical_writes: empty_oram_write_batch(),"
  , "        path_leaf: None,"
  , "        path_transition: None,"
  , "    })"
  , "}"
  , ""
  , "pub(super) fn path_access_transcript("
  , "    state: &OramState,"
  , "    spec: &StateObject,"
  , "    leaf: usize,"
  , ") -> Result<OramTranscript> {"
  , "    if state.storage.directory_pages.len() != state.parameters.metadata_pages {"
  , "        bail!("
  , "            \"path ORAM transcript directory page count {} mismatched public bound {} for {}\","
  , "            state.storage.directory_pages.len(),"
  , "            state.parameters.metadata_pages,"
  , "            spec.name"
  , "        );"
  , "    }"
  , "    if state.storage.buckets.len() != state.parameters.bucket_count {"
  , "        bail!("
  , "            \"path ORAM transcript bucket count {} mismatched public bound {} for {}\","
  , "            state.storage.buckets.len(),"
  , "            state.parameters.bucket_count,"
  , "            spec.name"
  , "        );"
  , "    }"
  , "    let public_access_count ="
  , "        1 + state.storage.directory_pages.len() + state.parameters.buckets_per_access;"
  , "    let mut logical_accesses = FixedBoxBuilder::new(public_access_count);"
  , "    let mut physical_reads = FixedBoxBuilder::new(public_access_count);"
  , ""
  , "    logical_accesses.push(LogicalEvent {"
  , "        kind: \"uooram_counter\".into(),"
  , "        object: spec.name.clone(),"
  , "        detail: \"counter\".into(),"
  , "    })?;"
  , "    physical_reads.push(PhysicalReadEvent {"
  , "        object: spec.name.clone(),"
  , "        location: format!(\"{}@counter\", spec.name),"
  , "        len: state.storage.access_counter_slot.len(),"
  , "    })?;"
  , ""
  , "    for page in 0..state.storage.directory_pages.len() {"
  , "        let directory_page = state.storage.directory_pages.get(page).ok_or_else(|| {"
  , "            anyhow!("
  , "                \"path ORAM transcript directory page index {} missing despite public count guard for {}\","
  , "                page,"
  , "                spec.name"
  , "            )"
  , "        })?;"
  , "        logical_accesses.push(LogicalEvent {"
  , "            kind: \"uooram_metadata_load\".into(),"
  , "            object: spec.name.clone(),"
  , "            detail: format!(\"page:{page}\"),"
  , "        })?;"
  , "        physical_reads.push(PhysicalReadEvent {"
  , "            object: spec.name.clone(),"
  , "            location: format!(\"{}@meta{page}\", spec.name),"
  , "            len: directory_page.len(),"
  , "        })?;"
  , "    }"
  , ""
  , "    let mut transcript_result = Ok(());"
  , "    for_each_bucket_on_leaf_path_root_to_leaf(state.parameters.leaf_count(), leaf, |index| {"
  , "        if transcript_result.is_err() {"
  , "            return;"
  , "        }"
  , "        transcript_result = (|| -> Result<()> {"
  , "            let bucket = state.storage.buckets.get(index).ok_or_else(|| {"
  , "                anyhow!("
  , "                    \"path ORAM transcript bucket index {} missing despite public count guard for {}\","
  , "                    index,"
  , "                    spec.name"
  , "                )"
  , "            })?;"
  , "            logical_accesses.push(LogicalEvent {"
  , "                kind: \"uooram_path_read\".into(),"
  , "                object: spec.name.clone(),"
  , "                detail: format!(\"bucket:{index}\"),"
  , "            })?;"
  , "            physical_reads.push(PhysicalReadEvent {"
  , "                object: spec.name.clone(),"
  , "                location: format!(\"{}@bucket{index}\", spec.name),"
  , "                len: bucket.len(),"
  , "            })?;"
  , "            Ok(())"
  , "        })();"
  , "    });"
  , "    transcript_result?;"
  , ""
  , "    Ok(OramTranscript {"
  , "        logical_accesses: logical_accesses.finish()?,"
  , "        physical_reads: physical_reads.finish()?,"
  , "        physical_writes: empty_oram_write_batch(),"
  , "        path_leaf: Some(leaf),"
  , "        path_transition: None,"
  , "    })"
  , "}"
