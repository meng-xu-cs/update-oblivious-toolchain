    , "        ORAM_SLOT_INDEX_BYTES + ORAM_LEAF_LABEL_BYTES"
    , "    } else {"
    , "        0"
    , "    };"
    , "    let expected_len = 1 + path_bytes + key_len + value_len;"
    , "    if bytes.len() != expected_len {"
    , "        bail!("
    , "            \"unexpected ORAM block length for {}: {} != {}\","
    , "            spec.name,"
    , "            bytes.len(),"
    , "            expected_len"
    , "        );"
    , "    }"
    , "    let occupied_tag = *read_exact_range(bytes, 0, 1, \"reading ORAM block tag\")?"
    , "        .first()"
    , "        .ok_or_else(|| anyhow!(\"ORAM block tag missing for {}\", spec.name))?;"
    , "    let occupied = match occupied_tag {"
    , "        0 => false,"
    , "        1 => true,"
    , "        other => bail!(\"invalid ORAM block tag {other:#x} for {}\", spec.name),"
    , "    };"
    , "    let (slot_index, leaf, key_start) = if is_path_oram_scheme(&spec.oram_scheme) {"
    , "        ("
    , "            usize::try_from(read_u64_be_at(bytes, 1, \"reading ORAM block slot index\")?)"
    , "                .map_err(|_| anyhow!(\"slot index overflow for {}\", spec.name))?,"
    , "            usize::try_from(read_u64_be_at(bytes, 9, \"reading ORAM block leaf label\")?)"
