    , "pub(super) fn rewrite_path_for_access<F>("
    , "    state: &mut OramState,"
    , "    spec: &StateObject,"
    , "    access_leaf: usize,"
    , "    allocator: &mut AllocatorSession,"
    , "    rng: &mut ChaCha20Rng,"
    , "    update: F,"
    , ") -> Result<(OramWriteBatch, bool)>"
    , "where"
    , "    F: FnOnce("
    , "        &mut [MapEntry],"
    , "        &mut [MaskedUsizeOption],"
    , "        &mut FixedStash,"
    , "        &mut ChaCha20Rng,"
    , "    ) -> Result<bool>,"
    , "{"
    , "    let mut writes = oram_write_log_with_capacity(oram_write_log_capacity(&state.parameters)?)?;"
    , "    let mut working_entries = std::mem::take(&mut state.entries);"
    , "    let mut working_position_map = std::mem::take(&mut state.position_map);"
    , "    let mut working_stash = std::mem::replace(&mut state.stash, FixedStash::placeholder());"
    , "    let required_stash_capacity = working_stash_capacity(&state.parameters)?;"
    , "    if working_stash.capacity() < required_stash_capacity {"
    , "        bail!("
    , "            \"working stash capacity {} fell below required public bound {} for {}\","
    , "            working_stash.capacity(),"
    , "            required_stash_capacity,"
    , "            spec.name"
    , "        );"
    , "    }"
    , ""
    , "    load_path_buckets_into_stash("
    , "        spec,"
    , "        &state.parameters,"
    , "        &state.cipher,"
    , "        &state.storage.buckets,"
    , "        access_leaf,"
    , "        allocator,"
    , "        &mut working_stash,"
    , "    )?;"
    , "    let mut update_failed = working_stash.overflowed();"
    , ""
    , "    let effect_failed = update("
    , "        &mut working_entries,"
    , "        &mut working_position_map,"
    , "        &mut working_stash,"
    , "        rng,"
    , "    )?;"
    , "    update_failed |= effect_failed;"
    , "    update_failed |="
    , "        working_stash.len() > state.parameters.stash_bound + state.parameters.buckets_per_access;"
    , ""
    , "    rebuild_path_buckets_from_stash("
    , "        spec,"
    , "        &state.parameters,"
    , "        &state.cipher,"
    , "        &mut state.storage.buckets,"
    , "        access_leaf,"
    , "        allocator,"
    , "        rng,"
    , "        &mut writes,"
    , "        &mut working_stash,"
    , "    )?;"
    , ""
    , "    update_failed |= working_stash.len() > state.parameters.stash_bound;"
    , ""
    , "    rewrite_path_metadata_pages_in_place("
    , "        spec,"
    , "        &state.parameters,"
    , "        &state.cipher,"
    , "        &working_position_map,"
    , "        &working_entries,"
    , "        working_stash.as_slice(),"
    , "        allocator,"
    , "        rng,"
    , "        &mut state.storage.directory_pages,"
    , "        &mut writes,"
    , "    )?;"
    , ""
    , "    let next_counter = state.access_counter + 1;"
    , "    rewrite_oram_counter_in_place("
    , "        spec,"
    , "        next_counter,"
    , "        &state.cipher,"
    , "        allocator,"
    , "        rng,"
    , "        &mut state.storage.access_counter_slot,"
    , "        &mut writes,"
    , "    )?;"
    , ""
    , "    state.entries = working_entries;"
    , "    state.position_map = working_position_map;"
    , "    state.stash = working_stash;"
    , "    state.access_counter = next_counter;"
    , "    Ok((finish_oram_write_log(writes)?, update_failed))"
    , "}"
    , ""
    , "pub(super) fn reconstruct_path_entries_from_storage_into("
    , "    spec: &StateObject,"
    , "    parameters: &OramParameters,"
    , "    cipher: &StoreCipher,"
    , "    buckets: &[Box<[u8]>],"
    , "    allocator: &mut AllocatorSession,"
    , "    empty_entry: &MapEntry,"
    , "    position_map: &[MaskedUsizeOption],"
    , "    stash: &FixedStash,"
    , "    entries: &mut [MapEntry],"
    , ") -> Result<()> {"
    , "    if entries.len() != parameters.capacity {"
    , "        bail!("
    , "            \"entry buffer length {} mismatched required public bound {} for {}\","
    , "            entries.len(),"
    , "            parameters.capacity,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    if buckets.len() != parameters.bucket_count {"
    , "        bail!("
    , "            \"path ORAM bucket count {} mismatched public bucket count {} for {}\","
    , "            buckets.len(),"
    , "            parameters.bucket_count,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    for entry in entries.iter_mut() {"
    , "        entry.wipe_secrets();"
    , "        assign_map_entry(entry, empty_entry);"
    , "        entry.set_vacant(empty_entry.value().clone());"
    , "        entry.set_value(empty_entry.value().clone());"
    , "    }"
    , "    let mut live_slots ="
    , "        repeat_boxed_masked_usize_options(parameters.capacity, &MaskedUsizeOption::none())?;"
    , "    for block in stash.blocks.iter() {"
    , "        validate_live_path_block(spec, parameters, position_map, &mut live_slots, block)?;"
    , "        install_path_entry_from_block_if_occupied(spec, entries, block)?;"
    , "    }"
    , "    for index in 0..parameters.bucket_count {"
    , "        let bucket = buckets.get(index).ok_or_else(|| {"
    , "            anyhow!("
    , "                \"path ORAM bucket index {} missing despite public count guard for {}\","
    , "                index,"
    , "                spec.name"
    , "            )"
    , "        })?;"
    , "        with_opened_oram_payload("
    , "            format!(\"{}@bucket{}\", spec.name, index),"
    , "            oram_bucket_aad(spec, index),"
    , "            parameters.bucket_size,"
    , "            bucket,"
    , "            cipher,"
    , "            allocator,"
    , "            |payload| {"
    , "                decode_bucket_payload(spec, index, payload, |block| {"
    , "                    let off_path = block.occupied"
    , "                        & !bucket_on_leaf_path(parameters.leaf_count(), index, block.leaf);"
    , "                    if off_path {"
    , "                        bail!("
    , "                            \"decoded ORAM bucket {} for {} carries leaf {} off its path\","
    , "                            index,"
    , "                            spec.name,"
    , "                            block.leaf"
    , "                        );"
    , "                    }"
    , "                    validate_live_path_block("
    , "                        spec,"
    , "                        parameters,"
    , "                        position_map,"
    , "                        &mut live_slots,"
    , "                        &block,"
    , "                    )?;"
    , "                    install_path_entry_from_block_if_occupied(spec, entries, &block)?;"
    , "                    Ok(())"
    , "                })"
    , "            },"
    , "        )?;"
    , "    }"
    , "    for (slot_index, leaf) in position_map.iter().enumerate() {"
    , "        let live_slot = live_slots.get(slot_index).ok_or_else(|| {"
    , "            anyhow!("
    , "                \"live-slot index {} missing despite public capacity guard for {}\","
    , "                slot_index,"
    , "                spec.name"
    , "            )"
    , "        })?;"
    , "        if leaf.is_some() & !live_slot.is_some() {"
    , "            bail!("
    , "                \"decoded ORAM position map for {} references missing live block at slot {}\","
    , "                spec.name,"
    , "                slot_index"
    , "            );"
    , "        }"
    , "    }"
    , "    Ok(())"
    , "}"
