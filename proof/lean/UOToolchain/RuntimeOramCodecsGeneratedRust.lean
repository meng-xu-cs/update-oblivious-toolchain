  , "        record(node)?;"
  , "    }"
  , "    allocator.finish()?;"
  , "    let mut witness = FixedBoxBuilder::new(shape.capacity);"
  , "    for leaf in leaves.iter() {"
  , "        if !leaf.is_some() {"
  , "            bail!(\"a node of {} is missing from its tree\", spec.name);"
  , "        }"
  , "        witness.push(leaf.to_witness())?;"
  , "    }"
  , "    witness.finish()"
  , "}"
