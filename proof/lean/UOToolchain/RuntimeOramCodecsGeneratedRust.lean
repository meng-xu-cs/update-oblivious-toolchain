  , "pub(super) fn deserialize_oram_block(spec: &StateObject, bytes: &[u8]) -> Result<OramBlock> {"
  , "    let key_type = spec"
  , "        .key_type"
  , "        .as_ref()"
  , "        .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?;"
  , "    let key_len = fixed_scalar_width(key_type)?;"
  , "    let value_len = fixed_scalar_width(&spec.value_type)?;"
  , "    let path_bytes = if is_path_oram_scheme(&spec.oram_scheme) {"
  , "        ORAM_SLOT_INDEX_BYTES + ORAM_LEAF_LABEL_BYTES"
  , "    } else {"
  , "        0"
  , "    };"
  , "    let expected_len = 1 + path_bytes + key_len + value_len;"
  , "    if bytes.len() != expected_len {"
  , "        bail!("
  , "            \"unexpected ORAM block length for {}: {} != {}\","
  , "            spec.name,"
  , "            bytes.len(),"
  , "            expected_len"
  , "        );"
  , "    }"
  , "    let occupied_tag = *read_exact_range(bytes, 0, 1, \"reading ORAM block tag\")?"
  , "        .first()"
  , "        .ok_or_else(|| anyhow!(\"ORAM block tag missing for {}\", spec.name))?;"
  , "    let occupied = match occupied_tag {"
  , "        0 => false,"
  , "        1 => true,"
  , "        other => bail!(\"invalid ORAM block tag {other:#x} for {}\", spec.name),"
  , "    };"
  , "    let (slot_index, leaf, key_start) = if is_path_oram_scheme(&spec.oram_scheme) {"
  , "        ("
  , "            usize::try_from(read_u64_be_at(bytes, 1, \"reading ORAM block slot index\")?)"
  , "                .map_err(|_| anyhow!(\"slot index overflow for {}\", spec.name))?,"
  , "            usize::try_from(read_u64_be_at(bytes, 9, \"reading ORAM block leaf label\")?)"
  , "                .map_err(|_| anyhow!(\"leaf label overflow for {}\", spec.name))?,"
  , "            17,"
  , "        )"
  , "    } else {"
  , "        (0, 0, 1)"
  , "    };"
  , "    Ok(OramBlock {"
  , "        occupied,"
  , "        slot_index,"
  , "        leaf,"
  , "        key: decode_scalar_value("
  , "            key_type,"
  , "            read_exact_range(bytes, key_start, key_len, \"reading ORAM block key\")?,"
  , "        )?,"
  , "        value: decode_scalar_value("
  , "            &spec.value_type,"
  , "            read_exact_range("
  , "                bytes,"
  , "                key_start + key_len,"
  , "                value_len,"
  , "                \"reading ORAM block value\","
  , "            )?,"
  , "        )?,"
  , "    })"
  , "}"
