    , "pub(super) fn directory_page_entries<T>(entries: &[T], page: usize) -> &[T] {"
    , "    let start = page.saturating_mul(ORAM_DIRECTORY_PAGE_ENTRIES);"
    , "    if start >= entries.len() {"
    , "        &[]"
    , "    } else {"
    , "        let take = entries"
    , "            .len()"
    , "            .saturating_sub(start)"
    , "            .min(ORAM_DIRECTORY_PAGE_ENTRIES);"
    , "        let end = start.saturating_add(take);"
    , "        match entries.get(start..end) {"
    , "            Some(page_entries) => page_entries,"
    , "            None => &[],"
    , "        }"
    , "    }"
    , "}"
    , ""
    , "fn levels_for_leaf_count(leaf_count: usize) -> usize {"
    , "    let leaf_count = leaf_count.max(1);"
    , "    let mut levels = 0usize;"
    , "    let mut width = leaf_count;"
    , "    while width > 0 {"
    , "        levels += 1;"
    , "        width /= 2;"
    , "    }"
    , "    levels"
    , "}"
    , ""
    , "fn path_bucket_at_depth(leaf_count: usize, leaf: usize, depth: usize) -> usize {"
    , "    let leaf_count = leaf_count.max(1);"
    , "    let levels = levels_for_leaf_count(leaf_count);"
    , "    let mut node = leaf_count - 1 + (leaf % leaf_count);"
    , "    let ascents = levels.saturating_sub(1).saturating_sub(depth);"
    , "    for _ in 0..ascents {"
    , "        node = node.saturating_sub(1) / 2;"
    , "    }"
    , "    node"
    , "}"
    , ""
    , "#[cfg(test)]"
    , "pub(super) fn path_bucket_indices(leaf_count: usize, leaf: usize) -> Vec<usize> {"
    , "    let levels = levels_for_leaf_count(leaf_count);"
    , "    let mut path = Vec::new();"
    , "    for depth in 0..levels {"
    , "        path.push(path_bucket_at_depth(leaf_count, leaf, depth));"
    , "    }"
    , "    path"
    , "}"
    , ""
    , "pub(super) fn for_each_surrogate_bucket_window<E, F>("
    , "    buckets_per_access: usize,"
    , "    access_counter: usize,"
    , "    bucket_count: usize,"
    , "    mut f: F,"
    , ") -> Result<(), E>"
    , "where"
    , "    F: FnMut(usize) -> Result<(), E>,"
    , "{"
    , "    for offset in 0..buckets_per_access {"
    , "        f((access_counter + offset) % bucket_count)?;"
    , "    }"
    , "    Ok(())"
    , "}"
    , ""
    , "pub(super) fn for_each_bucket_on_leaf_path_root_to_leaf<F>(leaf_count: usize, leaf: usize, mut f: F)"
    , "where"
    , "    F: FnMut(usize),"
    , "{"
    , "    let levels = levels_for_leaf_count(leaf_count);"
    , "    for depth in 0..levels {"
    , "        f(path_bucket_at_depth(leaf_count, leaf, depth));"
    , "    }"
    , "}"
    , ""
    , "pub(super) fn for_each_bucket_on_leaf_path_leaf_to_root<F>(leaf_count: usize, leaf: usize, mut f: F)"
    , "where"
    , "    F: FnMut(usize),"
    , "{"
    , "    let levels = levels_for_leaf_count(leaf_count);"
    , "    for offset in 0..levels {"
    , "        let depth = levels - 1 - offset;"
    , "        f(path_bucket_at_depth(leaf_count, leaf, depth));"
    , "    }"
    , "}"
    , ""
    , "pub(super) fn bucket_on_leaf_path(leaf_count: usize, bucket_index: usize, leaf: usize) -> bool {"
    , "    let leaf_count = leaf_count.max(1);"
    , "    let levels = levels_for_leaf_count(leaf_count);"
    , "    let mut node = leaf_count - 1 + (leaf % leaf_count);"
    , "    let mut found = false;"
    , "    for _ in 0..levels {"
    , "        found |= node == bucket_index;"
    , "        let parent = node.saturating_sub(1) / 2;"
    , "        node = masked_select_usize(node != 0, parent, 0);"
    , "    }"
    , "    found"
    , "}"
