  , "fn read_exact_range<'a>("
  , "    bytes: &'a [u8],"
  , "    start: usize,"
  , "    len: usize,"
  , "    context: &str,"
  , ") -> Result<&'a [u8]> {"
  , "    let end = checked_end(start, len, context)?;"
  , "    bytes.get(start..end).ok_or_else(|| {"
  , "        anyhow!("
  , "            \"ORAM codec input too short while {context}: range {}..{} exceeds {}\","
  , "            start,"
  , "            end,"
  , "            bytes.len()"
  , "        )"
  , "    })"
  , "}"
  , ""
  , "fn copy_exact_into(out: &mut [u8], input: &[u8], context: &str) -> Result<()> {"
  , "    if out.len() != input.len() {"
  , "        bail!("
  , "            \"ORAM codec exact copy length mismatch while {context}: {} != {}\","
  , "            out.len(),"
  , "            input.len()"
  , "        );"
  , "    }"
  , "    for (target, byte) in out.iter_mut().zip(input.iter()) {"
  , "        *target = *byte;"
  , "    }"
  , "    Ok(())"
  , "}"
  , ""
  , "fn write_exact_range(out: &mut [u8], start: usize, bytes: &[u8], context: &str) -> Result<usize> {"
  , "    let end = checked_end(start, bytes.len(), context)?;"
  , "    let out_len = out.len();"
  , "    let target = out.get_mut(start..end).ok_or_else(|| {"
  , "        anyhow!("
  , "            \"ORAM codec output too short while {context}: range {}..{} exceeds {}\","
  , "            start,"
  , "            end,"
  , "            out_len"
  , "        )"
  , "    })?;"
  , "    copy_exact_into(target, bytes, context)?;"
  , "    Ok(end)"
  , "}"
