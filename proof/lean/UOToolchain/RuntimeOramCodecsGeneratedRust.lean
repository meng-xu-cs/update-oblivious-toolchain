    , "    }"
    , "    let selected_live_slot ="
    , "        masked_select_option_usize(occupied, &MaskedUsizeOption::some(block.leaf), live_slot);"
    , "    let live_slot = live_slots.get_mut(slot_index).ok_or_else(|| {"
    , "        anyhow!("
    , "            \"live-slot index {} missing despite public capacity guard for {}\","
    , "            slot_index,"
    , "            spec.name"
    , "        )"
    , "    })?;"
