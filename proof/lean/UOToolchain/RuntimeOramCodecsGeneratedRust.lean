    , "        RuntimePathOramTransitionKind::ReadHit => 1u8,"
    , "        RuntimePathOramTransitionKind::WriteNoop => 2u8,"
    , "        RuntimePathOramTransitionKind::WriteInsert => 3u8,"
    , "        RuntimePathOramTransitionKind::WriteUpdate => 4u8,"
    , "        RuntimePathOramTransitionKind::WriteDelete => 5u8,"
    , "    };"
    , "    let false_tag = match when_false {"
    , "        RuntimePathOramTransitionKind::ReadMiss => 0u8,"
    , "        RuntimePathOramTransitionKind::ReadHit => 1u8,"
    , "        RuntimePathOramTransitionKind::WriteNoop => 2u8,"
    , "        RuntimePathOramTransitionKind::WriteInsert => 3u8,"
    , "        RuntimePathOramTransitionKind::WriteUpdate => 4u8,"
    , "        RuntimePathOramTransitionKind::WriteDelete => 5u8,"
    , "    };"
    , "    match masked_select_usize(cond, true_tag as usize, false_tag as usize) as u8 {"
    , "        0 => RuntimePathOramTransitionKind::ReadMiss,"
    , "        1 => RuntimePathOramTransitionKind::ReadHit,"
    , "        2 => RuntimePathOramTransitionKind::WriteNoop,"
    , "        3 => RuntimePathOramTransitionKind::WriteInsert,"
    , "        4 => RuntimePathOramTransitionKind::WriteUpdate,"
