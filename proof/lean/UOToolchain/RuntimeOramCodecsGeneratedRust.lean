    , "    entries: &[MapEntry],"
    , "    access_counter: u64,"
    , "    allocator: &mut AllocatorSession,"
    , "    rng: &mut ChaCha20Rng,"
    , "    buckets: &mut [Box<[u8]>],"
    , "    writes: &mut OramWriteLog,"
    , ") -> Result<()> {"
    , "    if buckets.len() != parameters.bucket_count {"
    , "        bail!("
    , "            \"surrogate ORAM bucket count {} did not match public bucket count {} for {}\","
    , "            buckets.len(),"
    , "            parameters.bucket_count,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    for_each_surrogate_bucket_window("
    , "        parameters.buckets_per_access,"
    , "        access_counter as usize,"
    , "        buckets.len(),"
    , "        |index| {"
    , "            let bucket = oram_bucket_from_entries(spec, entries, access_counter, index)?;"
    , "            let mut payload = oram_bucket_bytes(&bucket, spec)?;"
    , "            let sealed_bucket = buckets.get_mut(index).ok_or_else(|| {"
    , "                anyhow!("
    , "                    \"surrogate ORAM bucket index {} missing despite public count guard for {}\","
    , "                    index,"
    , "                    spec.name"
    , "                )"
    , "            })?;"
    , "            reseal_oram_payload_and_record_write("
    , "                writes,"
    , "                format!(\"{}@bucket{index}\", spec.name),"
    , "                oram_bucket_aad(spec, index),"
    , "                payload.as_mut(),"
    , "                sealed_bucket,"
    , "                cipher,"
    , "                rng,"
    , "                allocator,"
    , "            )?;"
    , "            Ok::<(), anyhow::Error>(())"
    , "        },"
    , "    )"
    , "}"
