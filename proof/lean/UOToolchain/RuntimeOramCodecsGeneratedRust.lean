    , "pub(super) fn select_stash_index_with_limit("
    , "    stash: &FixedStash,"
    , "    limit: usize,"
    , "    mut predicate: impl FnMut(&OramBlock) -> bool,"
    , ") -> MaskedUsizeOption {"
    , "    let public_limit = limit.min(stash.blocks.len());"
    , "    let mut selected = 0usize;"
    , "    let mut present = false;"
    , "    for (index, block) in stash.blocks.iter().enumerate() {"
    , "        let matches = (index < public_limit) & predicate(block);"
    , "        let choose_here = !present & matches;"
    , "        selected = masked_select_usize(choose_here, index, selected);"
    , "        present |= matches;"
    , "    }"
    , "    MaskedUsizeOption::new(present, selected)"
