  , "        let mut payload = zeroed_boxed_bytes(parameters.directory_page_bytes)?;"
  , "        encode_path_stash_page_into("
  , "            spec,"
  , "            parameters,"
  , "            directory_page_entries(stash, page),"
  , "            &empty_block,"
  , "            payload.as_mut(),"
  , "        )?;"
  , "        let aad = oram_meta_aad(spec, parameters.position_map_pages() + page);"
