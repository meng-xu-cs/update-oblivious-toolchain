    , "pub(super) fn validate_live_path_block("
    , "    spec: &StateObject,"
    , "    parameters: &OramParameters,"
    , "    position_map: &[MaskedUsizeOption],"
    , "    live_slots: &mut [MaskedUsizeOption],"
    , "    block: &OramBlock,"
    , ") -> Result<()> {"
    , "    if position_map.len() != parameters.capacity {"
    , "        bail!("
    , "            \"position-map buffer length {} mismatched public capacity {} for {}\","
    , "            position_map.len(),"
    , "            parameters.capacity,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    if live_slots.len() != parameters.capacity {"
    , "        bail!("
    , "            \"live-slot buffer length {} mismatched public capacity {} for {}\","
    , "            live_slots.len(),"
    , "            parameters.capacity,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    let occupied = block.occupied;"
    , "    let slot_in_range = block.slot_index < position_map.len();"
    , "    if occupied & !slot_in_range {"
    , "        bail!("
    , "            \"decoded ORAM live block for {} references out-of-range slot {}\","
    , "            spec.name,"
    , "            block.slot_index"
    , "        );"
    , "    }"
    , "    if occupied & (block.leaf >= parameters.leaf_count()) {"
    , "        bail!("
    , "            \"decoded ORAM live block for {} carries out-of-range leaf {}\","
    , "            spec.name,"
    , "            block.leaf"
    , "        );"
    , "    }"
    , "    let slot_index = masked_select_usize(slot_in_range, block.slot_index, 0);"
    , "    let expected_leaf = position_map.get(slot_index).ok_or_else(|| {"
    , "        anyhow!("
    , "            \"position-map slot index {} missing despite public capacity guard for {}\","
    , "            slot_index,"
    , "            spec.name"
    , "        )"
    , "    })?;"
    , "    if occupied & !expected_leaf.is_some() {"
    , "        bail!("
    , "            \"decoded ORAM live block for {} has slot {} but position map is empty there\","
    , "            spec.name,"
    , "            block.slot_index"
    , "        );"
    , "    }"
    , "    let expected_leaf_value = expected_leaf.unwrap_or(0);"
    , "    if occupied & (expected_leaf_value != block.leaf) {"
