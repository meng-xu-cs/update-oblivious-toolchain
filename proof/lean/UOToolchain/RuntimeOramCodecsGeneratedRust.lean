    , "    decode_path_metadata_pages_into("
    , "        spec,"
    , "        parameters,"
    , "        cipher,"
    , "        directory_pages,"
    , "        &mut allocator,"
    , "        &mut position_map,"
    , "        &mut directory,"
    , "        &mut stash,"
    , "    )?;"
    , "    let mut entries = repeat_boxed_map_entries(parameters.capacity, empty_entry)?;"
    , "    reconstruct_path_entries_from_storage_into("
    , "        spec,"
    , "        parameters,"
    , "        cipher,"
    , "        buckets,"
    , "        &mut allocator,"
    , "        empty_entry,"
    , "        &position_map,"
    , "        &stash,"
    , "        &mut entries,"
    , "    )?;"
