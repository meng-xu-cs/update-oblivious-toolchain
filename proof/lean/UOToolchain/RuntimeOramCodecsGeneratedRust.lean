    , "    cipher: &StoreCipher,"
    , "    directory_pages: &[Box<[u8]>],"
    , "    buckets: &[Box<[u8]>],"
    , "    empty_entry: &MapEntry,"
    , ") -> Result<Box<[MapEntry]>> {"
    , "    let scratch = parameters"
