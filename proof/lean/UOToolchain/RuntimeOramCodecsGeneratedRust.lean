  , "pub(super) fn path_position_map_witness_leaves("
  , "    spec: &StateObject,"
  , "    parameters: &OramParameters,"
  , "    cipher: &StoreCipher,"
  , "    directory_pages: &[Box<[u8]>],"
  , ") -> Result<Box<[RuntimeMaskedUsizeOptionWitness]>> {"
  , "    let position_map = path_position_map_from_storage(spec, parameters, cipher, directory_pages)?;"
  , "    position_map_to_witness_boxed(&position_map)"
  , "}"
  , ""
  , "pub(super) fn position_map_to_witness_boxed("
  , "    position_map: &[MaskedUsizeOption],"
  , ") -> Result<Box<[RuntimeMaskedUsizeOptionWitness]>> {"
  , "    let mut leaves = FixedBoxBuilder::new(position_map.len());"
  , "    for leaf in position_map {"
  , "        leaves.push(leaf.to_witness())?;"
  , "    }"
  , "    leaves.finish()"
  , "}"
  , ""
  , "pub(super) fn push_fixed_stash(stash: &mut FixedStash, block: OramBlock) -> Result<()> {"
  , "    push_fixed_stash_with_limit(stash, block, stash.blocks.len())"
  , "}"
  , ""
  , "pub(super) fn push_fixed_stash_with_limit("
  , "    stash: &mut FixedStash,"
  , "    block: OramBlock,"
  , "    limit: usize,"
  , ") -> Result<()> {"
  , "    let should_insert = block.occupied;"
  , "    let slot = select_stash_index_with_limit(stash, limit, |candidate| !candidate.occupied);"
  , "    let slot_present = slot.is_some();"
  , "    stash.overflowed |= should_insert & !slot_present;"
  , "    let slot_index = slot.unwrap_or(0);"
  , "    for (index, candidate) in stash.blocks.iter_mut().enumerate() {"
  , "        let insert_here = should_insert & slot_present & (index == slot_index);"
  , "        *candidate = select_oram_block(insert_here, &block, candidate)?;"
  , "    }"
  , "    stash.len += usize::from(should_insert & slot_present);"
  , "    Ok(())"
  , "}"
  , ""
  , "pub(super) fn install_path_entry_from_block_if_occupied("
  , "    spec: &StateObject,"
  , "    entries: &mut [MapEntry],"
  , "    block: &OramBlock,"
  , ") -> Result<()> {"
  , "    let slot_in_range = block.slot_index < entries.len();"
  , "    let invalid_slot = block.occupied & !slot_in_range;"
  , "    if invalid_slot {"
  , "        bail!("
  , "            \"decoded ORAM live block for {} references out-of-range slot {}\","
  , "            spec.name,"
  , "            block.slot_index"
  , "        );"
  , "    }"
  , "    let slot_index = masked_select_usize(slot_in_range, block.slot_index, 0);"
  , "    let candidate = MapEntry::new(true, block.key.clone(), block.value.clone());"
  , "    for (index, entry) in entries.iter_mut().enumerate() {"
  , "        let write_here = block.occupied & (index == slot_index);"
  , "        *entry = select_map_entry(write_here, &candidate, entry)?;"
  , "    }"
  , "    Ok(())"
  , "}"
  , ""
  , "pub(super) fn oram_block_from_entry(entry: &MapEntry) -> OramBlock {"
  , "    OramBlock {"
  , "        occupied: entry.is_occupied(),"
  , "        slot_index: 0,"
  , "        leaf: 0,"
  , "        key: entry.key().clone(),"
  , "        value: entry.value().clone(),"
  , "    }"
  , "}"
  , ""
  , "pub(super) fn oram_bucket_with_live_blocks("
  , "    spec: &StateObject,"
  , "    access_counter: u64,"
  , "    bucket_index: usize,"
  , "    live_entry_count: usize,"
  , "    blocks: &[OramBlock],"
  , ") -> Result<OramBucket> {"
  , "    let parameters = OramParameters::for_spec(spec)?;"
  , "    if blocks.len() > parameters.blocks_per_bucket {"
  , "        bail!("
  , "            \"ORAM bucket {} for {} carries {} blocks beyond public budget {}\","
  , "            bucket_index,"
  , "            spec.name,"
  , "            blocks.len(),"
  , "            parameters.blocks_per_bucket"
  , "        );"
  , "    }"
  , "    let empty_block = empty_oram_block(spec)?;"
  , "    let mut fixed_blocks = repeat_boxed_oram_blocks(parameters.blocks_per_bucket, &empty_block)?;"
  , "    for (slot, block) in blocks.iter().enumerate() {"
  , "        let target = fixed_blocks.get_mut(slot).ok_or_else(|| {"
  , "            anyhow!("
  , "                \"ORAM bucket {} for {} live block slot {} missing despite public block budget {}\","
  , "                bucket_index,"
  , "                spec.name,"
  , "                slot,"
  , "                parameters.blocks_per_bucket"
  , "            )"
  , "        })?;"
  , "        assign_oram_block(target, block);"
  , "    }"
  , "    Ok(OramBucket {"
  , "        access_counter,"
  , "        bucket_index,"
  , "        live_entry_count,"
  , "        blocks: fixed_blocks,"
  , "    })"
  , "}"
  , ""
  , "pub(super) fn oram_bucket_from_entries("
  , "    spec: &StateObject,"
  , "    entries: &[MapEntry],"
  , "    access_counter: u64,"
  , "    bucket_index: usize,"
  , ") -> Result<OramBucket> {"
  , "    let parameters = OramParameters::for_spec(spec)?;"
  , "    let live_entry_count = entries.iter().fold(0usize, |count, entry| {"
  , "        count + usize::from(entry.is_occupied())"
  , "    });"
  , "    let empty_block = empty_oram_block(spec)?;"
