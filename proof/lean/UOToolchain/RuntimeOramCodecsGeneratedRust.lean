  , "pub(super) fn serialize_oram_block_into("
  , "    block: &OramBlock,"
  , "    spec: &StateObject,"
  , "    out: &mut [u8],"
  , ") -> Result<()> {"
  , "    let key_type = spec"
  , "        .key_type"
  , "        .as_ref()"
  , "        .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?;"
  , "    let key_len = fixed_scalar_width(key_type)?;"
  , "    let value_len = fixed_scalar_width(&spec.value_type)?;"
  , "    let path_bytes = if is_path_oram_scheme(&spec.oram_scheme) {"
  , "        ORAM_SLOT_INDEX_BYTES + ORAM_LEAF_LABEL_BYTES"
  , "    } else {"
  , "        0"
  , "    };"
  , "    let expected_len = 1 + path_bytes + key_len + value_len;"
  , "    if out.len() != expected_len {"
  , "        bail!("
  , "            \"unexpected ORAM block buffer length for {}: {} != {}\","
  , "            spec.name,"
  , "            out.len(),"
  , "            expected_len"
  , "        );"
  , "    }"
  , "    let mut cursor = write_exact_range("
  , "        out,"
  , "        0,"
  , "        &[u8::from(block.occupied)],"
  , "        \"writing ORAM block tag\","
  , "    )?;"
  , "    if is_path_oram_scheme(&spec.oram_scheme) {"
  , "        cursor = write_u64_be_at("
  , "            out,"
  , "            cursor,"
  , "            u64::try_from(block.slot_index)"
  , "                .map_err(|_| anyhow!(\"slot index overflow for {}\", spec.name))?,"
  , "            \"writing ORAM block slot index\","
  , "        )?;"
  , "        cursor = write_u64_be_at("
  , "            out,"
  , "            cursor,"
  , "            u64::try_from(block.leaf)"
  , "                .map_err(|_| anyhow!(\"leaf label overflow for {}\", spec.name))?,"
  , "            \"writing ORAM block leaf label\","
  , "        )?;"
  , "    }"
  , "    let mut overflowed = false;"
  , "    let mut copy_chunk = |chunk: &[u8]| {"
  , "        if overflowed {"
  , "            overflowed = true;"
  , "            return;"
  , "        }"
  , "        match write_exact_range(out, cursor, chunk, \"writing ORAM block canonical chunk\") {"
  , "            Ok(end) => cursor = end,"
  , "            Err(_) => overflowed = true,"
  , "        }"
  , "    };"
  , "    block.key.visit_canonical_chunks(&mut copy_chunk);"
  , "    block.value.visit_canonical_chunks(&mut copy_chunk);"
  , "    if overflowed || cursor != out.len() {"
  , "        bail!(\"ORAM block canonical encoding drifted from exact output length\");"
  , "    }"
  , "    Ok(())"
  , "}"
