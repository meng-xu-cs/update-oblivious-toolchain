  , "                \"ORAM directory key range {}..{} missing despite exact page size for {}\","
  , "                start,"
  , "                start + key_len,"
  , "                spec.name"
  , "            )"
  , "        })?;"
  , "        let mut key_cursor = 0usize;"
  , "        let mut overflowed = false;"
