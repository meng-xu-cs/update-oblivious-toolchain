    , "pub(super) fn apply_path_put_update("
    , "    spec: &StateObject,"
    , "    entries: &mut [MapEntry],"
    , "    position_map: &mut [MaskedUsizeOption],"
    , "    stash: &mut FixedStash,"
    , "    key: &Value,"
    , "    value: &Value,"
    , "    apply: bool,"
    , "    slot: &MaskedUsizeOption,"
    , "    insert_slot: &MaskedUsizeOption,"
    , "    next_leaf: &MaskedUsizeOption,"
    , ") -> Result<bool> {"
    , "    let slot_present = slot.is_some();"
    , "    let slot_index = slot.unwrap_or(0);"
    , "    let insert_slot_present = insert_slot.is_some();"
    , "    let insert_slot_index = insert_slot.unwrap_or(0);"
    , "    let value_is_zero = value.confidential_is_zero_like();"
    , "    let update_existing = apply & slot_present & !value_is_zero;"
    , "    let delete_existing = apply & slot_present & value_is_zero;"
    , "    let insert_new = apply & !slot_present & !value_is_zero & insert_slot_present;"
    , "    // A write that leaves a present key unchanged still remaps it, as a read"
    , "    // does; otherwise the next access to the key would read the same path."
    , "    let keep_existing = !apply & slot_present;"
    , "    let next_leaf_value = next_leaf.unwrap_or(0);"
    , "    let key_type = spec"
    , "        .key_type"
    , "        .as_ref()"
    , "        .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?;"
    , "    let zero_key = Value::zero_for_type(key_type);"
    , "    let zero_value = Value::zero_for_type(&spec.value_type);"
    , ""
    , "    let prior_leaf = select_position_map_leaf(position_map, slot);"
    , "    let prior_leaf_value = prior_leaf.unwrap_or(0);"
    , ""
    , "    // The directory keeps each slot's occupancy and key; the value lives"
    , "    // only in the key's block."
    , "    for (index, entry) in entries.iter_mut().enumerate() {"
    , "        let delete_here = delete_existing & (index == slot_index);"
    , "        let insert_here = insert_new & (index == insert_slot_index);"
    , "        let prior_key = entry.key().clone();"
    , "        let selected_key = Value::confidential_select(insert_here, key.clone(), prior_key)?;"
    , "        let next_key = Value::confidential_select(delete_here, zero_key.clone(), selected_key)?;"
    , "        let next_occupied = (entry.is_occupied() & !delete_here) | insert_here;"
    , "        entry.overwrite(next_occupied, next_key, zero_value.clone());"
    , "    }"
    , ""
    , "    for (index, leaf) in position_map.iter_mut().enumerate() {"
    , "        let remap_here = (update_existing | keep_existing) & (index == slot_index);"
    , "        let delete_here = delete_existing & (index == slot_index);"
    , "        let insert_here = insert_new & (index == insert_slot_index);"
    , "        let selected_leaf = masked_select_option_usize(remap_here, next_leaf, leaf);"
    , "        let empty_leaf = MaskedUsizeOption::none();"
    , "        let cleared_leaf = masked_select_option_usize(delete_here, &empty_leaf, &selected_leaf);"
    , "        let updated_leaf = masked_select_option_usize(insert_here, next_leaf, &cleared_leaf);"
    , "        assign_masked_usize_option(leaf, &updated_leaf);"
    , "    }"
    , ""
    , "    let mut slot_matches = 0usize;"
    , "    let mut slot_blocks_agree = true;"
    , "    let mut inserted_slot = false;"
    , "    for block in stash.blocks.iter_mut() {"
    , "        let was_occupied = block.occupied;"
    , "        let slot_match = was_occupied & slot_present & (block.slot_index == slot_index);"
    , "        let consistent = (block.leaf == prior_leaf_value) & Value::confidential_eq(&block.key, key);"
    , "        slot_blocks_agree &= !slot_match | consistent;"
    , "        let update_here = update_existing & slot_match;"
    , "        let remap_here = (update_existing | keep_existing) & slot_match;"
    , "        let delete_here = delete_existing & slot_match;"
    , "        let insert_here = insert_new & !inserted_slot & !was_occupied;"
    , "        let prior_key = block.key.clone();"
    , "        let prior_value = block.value.clone();"
    , "        let next_slot_index = masked_select_usize("
    , "            insert_here,"
    , "            insert_slot_index,"
    , "            masked_select_usize(delete_here, 0, block.slot_index),"
    , "        );"
    , "        let selected_leaf ="
    , "            masked_select_usize(remap_here | insert_here, next_leaf_value, block.leaf);"
    , "        let next_leaf_label = masked_select_usize(delete_here, 0, selected_leaf);"
    , "        let selected_key = Value::confidential_select(insert_here, key.clone(), prior_key)?;"
    , "        let next_key = Value::confidential_select(delete_here, zero_key.clone(), selected_key)?;"
    , "        let selected_value ="
    , "            Value::confidential_select(update_here | insert_here, value.clone(), prior_value)?;"
    , "        let next_value ="
    , "            Value::confidential_select(delete_here, zero_value.clone(), selected_value)?;"
    , "        let next_occupied = (was_occupied & !delete_here) | insert_here;"
    , "        block.overwrite("
    , "            next_occupied,"
    , "            next_slot_index,"
    , "            next_leaf_label,"
    , "            next_key,"
    , "            next_value,"
    , "        );"
    , "        slot_matches += usize::from(slot_match);"
    , "        inserted_slot |= insert_here;"
    , "    }"
    , ""
    , "    stash.len = stash"
    , "        .blocks"
    , "        .iter()"
    , "        .fold(0usize, |acc, block| acc + usize::from(block.occupied));"
    , "    // A present slot has exactly one block, on its prior leaf and with its"
    , "    // key."
    , "    let update_failed = ((update_existing | delete_existing | keep_existing)"
    , "        & ((slot_matches != 1) | !slot_blocks_agree))"
    , "        | (insert_new & !inserted_slot)"
    , "        | (insert_new & (insert_slot_index >= entries.len()));"
    , "    let _ = spec;"
    , "    Ok(update_failed)"
    , "}"
    , ""
    , "pub(super) fn apply_surrogate_put_update("
    , "    spec: &StateObject,"
    , "    entries: &mut [MapEntry],"
    , "    key: &Value,"
    , "    value: &Value,"
    , "    apply: bool,"
    , "    slot: &MaskedUsizeOption,"
    , "    insert_slot: &MaskedUsizeOption,"
    , ") -> Result<bool> {"
    , "    let slot_present = slot.is_some();"
    , "    let slot_index = slot.unwrap_or(0);"
    , "    let value_is_zero = value.confidential_is_zero_like();"
    , "    let request_insert = apply & !slot_present & !value_is_zero;"
    , "    let insert_slot_present = insert_slot.is_some();"
    , "    let insert_slot_index = insert_slot.unwrap_or(0);"
    , "    let key_type = spec"
    , "        .key_type"
    , "        .as_ref()"
    , "        .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?;"
    , "    let zero_key = Value::zero_for_type(key_type);"
    , "    let zero_value = Value::zero_for_type(&spec.value_type);"
    , ""
    , "    for (index, entry) in entries.iter_mut().enumerate() {"
    , "        let update_here = apply & slot_present & !value_is_zero & (index == slot_index);"
    , "        let delete_here = apply & slot_present & value_is_zero & (index == slot_index);"
    , "        let insert_here = apply"
    , "            & !slot_present"
    , "            & !value_is_zero"
    , "            & insert_slot_present"
    , "            & (index == insert_slot_index);"
    , "        let prior_key = entry.key().clone();"
    , "        let prior_value = entry.value().clone();"
    , "        let selected_key = Value::confidential_select(insert_here, key.clone(), prior_key)?;"
    , "        let next_key = Value::confidential_select(delete_here, zero_key.clone(), selected_key)?;"
    , "        let selected_value ="
    , "            Value::confidential_select(update_here | insert_here, value.clone(), prior_value)?;"
    , "        let next_value ="
    , "            Value::confidential_select(delete_here, zero_value.clone(), selected_value)?;"
    , "        let next_occupied = (entry.is_occupied() & !delete_here) | update_here | insert_here;"
    , "        entry.overwrite(next_occupied, next_key, next_value);"
    , "    }"
    , ""
    , "    let capacity_overflowed = request_insert & !insert_slot_present;"
    , "    let _ = spec;"
    , "    Ok(capacity_overflowed)"
    , "}"
    , ""
    , "pub(super) fn run_surrogate_get("
    , "    state: &OramState,"
    , "    spec: &StateObject,"
    , "    key: &Value,"
    , ") -> Result<(Value, OramTranscript, bool)> {"
    , "    let slot = slot_for_key(&state.entries, key);"
    , "    let value = select_entry_value_for_slot(&state.entries, &slot, &spec.value_type)?;"
    , "    Ok((value, surrogate_access_transcript(state, spec)?, false))"
    , "}"
    , ""
    , "pub(super) fn run_surrogate_put("
    , "    state: &mut OramState,"
    , "    spec: &StateObject,"
    , "    key: Value,"
    , "    value: Value,"
    , "    apply: bool,"
    , ") -> Result<(OramTranscript, bool)> {"
    , "    let transcript = surrogate_access_transcript(state, spec)?;"
    , "    let slot = slot_for_key(&state.entries, &key);"
    , "    let slot_present = slot.is_some();"
    , "    let value_is_zero = value.confidential_is_zero_like();"
    , "    let request_insert = apply & !slot_present & !value_is_zero;"
    , "    let vacant_slot = allocate_slot(&state.entries);"
    , "    let no_insert_slot = MaskedUsizeOption::none();"
    , "    let insert_slot = masked_select_option_usize(request_insert, &vacant_slot, &no_insert_slot);"
    , "    let capacity_overflowed = apply_surrogate_put_update("
    , "        spec,"
    , "        &mut state.entries,"
    , "        &key,"
    , "        &value,"
    , "        apply,"
    , "        &slot,"
    , "        &insert_slot,"
    , "    )?;"
    , "    Ok((transcript, capacity_overflowed))"
    , "}"
    , ""
    , "pub(super) fn run_path_get("
    , "    state: &mut OramState,"
    , "    spec: &StateObject,"
    , "    key: &Value,"
    , "    allocator: &mut AllocatorSession,"
    , "    leaf_coins: &mut PathOramLeafCoinSource,"
    , "    rng: &mut ChaCha20Rng,"
    , ") -> Result<(Value, OramTranscript, bool)> {"
    , "    let leaf_count = state.parameters.leaf_count();"
    , "    let fresh_leaf ="
    , "        leaf_coins.take_leaf(spec.id, &spec.name, state.access_counter, leaf_count, rng)?;"
    , "    let access_leaf = access_leaf_for_key(&state.entries, &state.position_map, key, fresh_leaf);"
    , "    let slot = slot_for_key(&state.entries, key);"
    , "    let slot_present = slot.is_some();"
    , "    let prior_leaf = select_position_map_leaf(&state.position_map, &slot);"
    , "    let fresh_leaf_option = MaskedUsizeOption::some(fresh_leaf);"
    , "    let no_next_leaf = MaskedUsizeOption::none();"
    , "    let next_leaf = masked_select_option_usize(slot_present, &fresh_leaf_option, &no_next_leaf);"
    , "    let mut return_value = Value::zero_for_type(&spec.value_type);"
    , "    let (writes, update_failed) = rewrite_path_for_access("
    , "        state,"
    , "        spec,"
    , "        access_leaf,"
    , "        allocator,"
    , "        rng,"
    , "        |_entries, position_map, stash, _rng| {"
    , "            // The map's values live only in its blocks: the key's block is"
    , "            // in the stash once its path has been read."
    , "            let (value, block_failed) ="
    , "                select_stash_value_for_slot(stash, &slot, &prior_leaf, key, &spec.value_type)?;"
    , "            return_value = value;"
    , "            apply_path_get_update(position_map, stash, &slot, &next_leaf);"
    , "            Ok(block_failed)"
    , "        },"
    , "    )?;"
    , "    let mut transcript = path_access_transcript(state, spec, access_leaf)?;"
    , "    transcript.physical_writes = writes;"
    , "    transcript.path_transition = Some(RuntimePathOramTransitionWitness {"
    , "        object_id: spec.id,"
    , "        object_name: spec.name.clone(),"
    , "        bucket_count: state.parameters.bucket_count,"
    , "        kind: masked_select_transition_kind("
    , "            slot_present,"
    , "            RuntimePathOramTransitionKind::ReadHit,"
    , "            RuntimePathOramTransitionKind::ReadMiss,"
    , "        ),"
    , "        fresh_leaf: next_leaf.unwrap_or(access_leaf),"
    , "        slot_index: slot.to_witness(),"
    , "        prior_leaf: prior_leaf.to_witness(),"
    , "        next_leaf: next_leaf.to_witness(),"
    , "    });"
    , "    Ok((return_value, transcript, update_failed))"
    , "}"
    , ""
    , "pub(super) fn run_path_put("
    , "    state: &mut OramState,"
    , "    spec: &StateObject,"
    , "    key: Value,"
    , "    value: Value,"
    , "    apply: bool,"
    , "    allocator: &mut AllocatorSession,"
    , "    leaf_coins: &mut PathOramLeafCoinSource,"
    , "    rng: &mut ChaCha20Rng,"
    , ") -> Result<(OramTranscript, bool)> {"
    , "    let leaf_count = state.parameters.leaf_count();"
    , "    let slot = slot_for_key(&state.entries, &key);"
    , "    let slot_present = slot.is_some();"
    , "    let prior_leaf = select_position_map_leaf(&state.position_map, &slot);"
    , "    let miss_access_leaf ="
    , "        leaf_coins.take_leaf(spec.id, &spec.name, state.access_counter, leaf_count, rng)?;"
    , "    let access_leaf = masked_select_usize("
    , "        prior_leaf.is_some(),"
    , "        prior_leaf.unwrap_or(0),"
    , "        miss_access_leaf,"
    , "    );"
    , "    let value_is_zero = value.confidential_is_zero_like();"
    , "    let request_insert = apply & !slot_present & !value_is_zero;"
    , "    let vacant_slot = allocate_slot(&state.entries);"
    , "    let no_insert_slot = MaskedUsizeOption::none();"
    , "    let insert_slot = masked_select_option_usize(request_insert, &vacant_slot, &no_insert_slot);"
    , "    let insert_slot_present = insert_slot.is_some();"
    , "    // A write of a new key to a full map aborts the call, as on the other"
    , "    // map routes; the access itself proceeds as a no-op."
    , "    let capacity_overflowed = request_insert & !insert_slot_present;"
    , "    let update_existing = apply & slot_present & !value_is_zero;"
    , "    let delete_existing = apply & slot_present & value_is_zero;"
    , "    let insert_new = apply & !slot_present & !value_is_zero & insert_slot_present;"
    , "    let keep_existing = !apply & slot_present;"
    , "    let next_leaf_value ="
    , "        leaf_coins.take_leaf(spec.id, &spec.name, state.access_counter, leaf_count, rng)?;"
    , "    let selected_next_leaf = MaskedUsizeOption::some(next_leaf_value);"
    , "    let no_next_leaf = MaskedUsizeOption::none();"
    , "    let next_leaf = masked_select_option_usize("
    , "        update_existing | insert_new | keep_existing,"
    , "        &selected_next_leaf,"
    , "        &no_next_leaf,"
    , "    );"
    , "    let mut transition_kind = RuntimePathOramTransitionKind::WriteNoop;"
    , "    transition_kind = masked_select_transition_kind("
    , "        insert_new,"
    , "        RuntimePathOramTransitionKind::WriteInsert,"
    , "        transition_kind,"
    , "    );"
    , "    transition_kind = masked_select_transition_kind("
    , "        update_existing,"
    , "        RuntimePathOramTransitionKind::WriteUpdate,"
    , "        transition_kind,"
    , "    );"
    , "    transition_kind = masked_select_transition_kind("
    , "        delete_existing,"
    , "        RuntimePathOramTransitionKind::WriteDelete,"
    , "        transition_kind,"
    , "    );"
    , "    let transition_slot = masked_select_option_usize(insert_new, &insert_slot, &slot);"
    , "    let mut transition_next_leaf = MaskedUsizeOption::none();"
    , "    assign_masked_usize_option(&mut transition_next_leaf, &next_leaf);"
    , "    let transition_fresh_leaf = transition_next_leaf.unwrap_or(access_leaf);"
    , "    let transition = RuntimePathOramTransitionWitness {"
    , "        object_id: spec.id,"
    , "        object_name: spec.name.clone(),"
    , "        bucket_count: state.parameters.bucket_count,"
    , "        kind: transition_kind,"
    , "        fresh_leaf: transition_fresh_leaf,"
    , "        slot_index: transition_slot.to_witness(),"
    , "        prior_leaf: prior_leaf.to_witness(),"
    , "        next_leaf: transition_next_leaf.to_witness(),"
    , "    };"
    , "    let (writes, update_failed) = rewrite_path_for_access("
    , "        state,"
    , "        spec,"
    , "        access_leaf,"
    , "        allocator,"
    , "        rng,"
    , "        |entries, position_map, stash, _rng| {"
    , "            apply_path_put_update("
    , "                spec,"
    , "                entries,"
    , "                position_map,"
    , "                stash,"
    , "                &key,"
    , "                &value,"
    , "                apply,"
    , "                &slot,"
    , "                &insert_slot,"
    , "                &next_leaf,"
    , "            )"
    , "        },"
    , "    )?;"
    , "    let mut transcript = path_access_transcript(state, spec, access_leaf)?;"
    , "    transcript.physical_writes = writes;"
    , "    transcript.path_transition = Some(transition);"
    , "    Ok((transcript, update_failed | capacity_overflowed))"
    , "}"
    , ""
    , "pub(super) fn run_path_commit_put("
    , "    state: &mut OramState,"
    , "    spec: &StateObject,"
    , "    put: &super::PendingOramPut,"
    , "    aborted: bool,"
    , "    allocator: &mut AllocatorSession,"
    , "    leaf_coins: &mut PathOramLeafCoinSource,"
    , "    rng: &mut ChaCha20Rng,"
    , ") -> Result<OramTranscript> {"
    , "    // A write of an aborted call is masked off but still makes its access,"
    , "    // so the call leaves the trace of a committed one and needs no rollback."
    , "    let apply = put.apply & !aborted;"
    , "    let (transcript, update_failed) = run_path_put("
    , "        state,"
    , "        spec,"
    , "        put.key.clone(),"
    , "        put.value.clone(),"
    , "        apply,"
    , "        allocator,"
    , "        leaf_coins,"
    , "        rng,"
    , "    )?;"
    , "    // The pending view applied the same writes to the same contents and"
    , "    // found no overflow, or the call aborted and every write is masked off;"
    , "    // the stash bound is the capacity. A failure here means the view and the"
    , "    // ORAM disagree, so stop rather than commit."
    , "    if update_failed {"
    , "        bail!("
    , "            \"path ORAM write to {} failed at commit; the pending view and the ORAM disagree\","
    , "            spec.name"
    , "        );"
    , "    }"
    , "    Ok(transcript)"
    , "}"
    , ""
    , "pub(super) fn empty_map_entry(spec: &StateObject) -> Result<MapEntry> {"
    , "    Ok(MapEntry::new("
    , "        false,"
    , "        Value::zero_for_type("
    , "            spec.key_type"
    , "                .as_ref()"
    , "                .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?,"
    , "        ),"
    , "        Value::zero_for_type(&spec.value_type),"
    , "    ))"
    , "}"
    , ""
    , "pub(super) fn decode_surrogate_entries_from_storage_into("
    , "    spec: &StateObject,"
    , "    parameters: &OramParameters,"
    , "    cipher: &StoreCipher,"
    , "    directory_pages: &[Box<[u8]>],"
    , "    allocator: &mut AllocatorSession,"
    , "    empty_entry: &MapEntry,"
    , "    entries: &mut [MapEntry],"
    , ") -> Result<()> {"
    , "    if entries.len() != parameters.capacity {"
    , "        bail!("
    , "            \"surrogate ORAM entry buffer length {} mismatched public slot count {} for {}\","
    , "            entries.len(),"
    , "            parameters.capacity,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    for entry in entries.iter_mut() {"
    , "        entry.wipe_secrets();"
    , "        assign_map_entry(entry, empty_entry);"
    , "    }"
    , "    let mut next_entry_index = 0usize;"
    , "    for (page_index, page) in directory_pages.iter().enumerate() {"
    , "        if next_entry_index == parameters.capacity {"
    , "            break;"
    , "        }"
    , "        let remaining = parameters.capacity - next_entry_index;"
    , "        with_opened_oram_payload("
    , "            format!(\"{}@meta{}\", spec.name, page_index),"
    , "            oram_meta_aad(spec, page_index),"
    , "            parameters.directory_page_bytes,"
    , "            page,"
    , "            cipher,"
    , "            allocator,"
    , "            |payload| -> Result<()> {"
    , "                let entry_tail = entries.get_mut(next_entry_index..).ok_or_else(|| {"
    , "                    anyhow!("
    , "                        \"surrogate directory decode tail index {} missing despite capacity guard for {}\","
    , "                        next_entry_index,"
    , "                        spec.name"
    , "                    )"
    , "                })?;"
    , "                let decoded ="
    , "                    decode_oram_directory_page_into_slice(payload, spec, remaining, entry_tail)?;"
    , "                next_entry_index += decoded;"
    , "                Ok(())"
    , "            },"
    , "        )?;"
    , "    }"
    , "    Ok(())"
    , "}"
    , ""
    , "pub(super) fn empty_oram_block(spec: &StateObject) -> Result<OramBlock> {"
    , "    Ok(OramBlock {"
    , "        occupied: false,"
    , "        slot_index: 0,"
    , "        leaf: 0,"
    , "        key: Value::zero_for_type("
    , "            spec.key_type"
    , "                .as_ref()"
    , "                .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?,"
    , "        ),"
    , "        value: Value::zero_for_type(&spec.value_type),"
    , "    })"
    , "}"
    , ""
    , "pub(super) fn fixed_stash_with_capacity(spec: &StateObject, capacity: usize) -> Result<FixedStash> {"
    , "    let empty_block = empty_oram_block(spec)?;"
    , "    Ok(FixedStash {"
    , "        empty_block: clone_oram_block(&empty_block),"
    , "        blocks: repeat_boxed_oram_blocks(capacity, &empty_block)?,"
    , "        len: 0,"
    , "        overflowed: false,"
    , "    })"
    , "}"
    , ""
    , "pub(super) fn clear_fixed_stash(stash: &mut FixedStash) {"
    , "    for block in &mut stash.blocks {"
    , "        block.wipe_secrets();"
    , "        assign_oram_block(block, &stash.empty_block);"
    , "    }"
    , "    stash.len = 0;"
    , "    stash.overflowed = false;"
    , "}"
    , ""
    , "pub(super) fn cold_commit_oram_state("
    , "    position_map: &mut [MaskedUsizeOption],"
    , "    entries: &mut [MapEntry],"
    , "    empty_entry: &MapEntry,"
    , "    stash: &mut FixedStash,"
    , ") {"
    , "    for leaf in position_map.iter_mut() {"
    , "        *leaf = MaskedUsizeOption::none();"
    , "    }"
    , "    for entry in entries.iter_mut() {"
    , "        entry.wipe_secrets();"
    , "        assign_map_entry(entry, empty_entry);"
    , "    }"
    , "    clear_fixed_stash(stash);"
    , "}"
