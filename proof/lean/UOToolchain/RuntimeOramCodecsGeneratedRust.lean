    , "/// Decodes each slot's leaf and, when `directory` is given, its key: the"
    , "/// directory a call finds a key's slot in. A directory entry holds no value;"
    , "/// the value lives in the key's block."
    , "pub(super) fn decode_path_position_map_pages_into("
    , "    spec: &StateObject,"
    , "    parameters: &OramParameters,"
    , "    cipher: &StoreCipher,"
    , "    pages: &[Box<[u8]>],"
    , "    allocator: &mut AllocatorSession,"
    , "    position_map: &mut [MaskedUsizeOption],"
    , "    mut directory: Option<&mut [MapEntry]>,"
    , ") -> Result<()> {"
    , "    if position_map.len() != parameters.capacity {"
    , "        bail!("
    , "            \"position-map buffer length {} mismatched public bound {} for {}\","
    , "            position_map.len(),"
    , "            parameters.capacity,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    if let Some(entries) = directory.as_deref() {"
    , "        if entries.len() != parameters.capacity {"
    , "            bail!("
    , "                \"directory buffer length {} mismatched public bound {} for {}\","
    , "                entries.len(),"
    , "                parameters.capacity,"
    , "                spec.name"
    , "            );"
    , "        }"
    , "    }"
    , "    let key_type = spec"
    , "        .key_type"
    , "        .as_ref()"
    , "        .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?;"
    , "    let key_len = path_directory_key_width(spec, parameters)?;"
    , "    let zero_key = Value::zero_for_type(key_type);"
    , "    let zero_value = Value::zero_for_type(&spec.value_type);"
    , "    let required_position_pages = parameters.position_map_pages();"
    , "    if pages.len() < required_position_pages {"
    , "        bail!("
    , "            \"position-map page count {} below public bound {} for {}\","
    , "            pages.len(),"
    , "            required_position_pages,"
    , "            spec.name"
    , "        );"
    , "    }"
    , "    for leaf in position_map.iter_mut() {"
    , "        *leaf = MaskedUsizeOption::none();"
    , "    }"
    , "    let mut next_slot = 0usize;"
    , "    for page in 0..parameters.position_map_pages() {"
    , "        with_opened_oram_payload("
    , "            format!(\"{}@meta{}\", spec.name, page),"
    , "            oram_meta_aad(spec, page),"
    , "            parameters.directory_page_bytes,"
    , "            pages.get(page).ok_or_else(|| {"
    , "                anyhow!("
    , "                    \"position-map page index {} missing despite public page-count guard for {}\","
    , "                    page,"
    , "                    spec.name"
    , "                )"
    , "            })?,"
    , "            cipher,"
    , "            allocator,"
    , "            |payload| -> Result<()> {"
    , "                for (entry_index, _) in payload"
    , "                    .chunks_exact(ORAM_LEAF_LABEL_BYTES)"
    , "                    .take(ORAM_DIRECTORY_PAGE_ENTRIES)"
    , "                    .enumerate()"
    , "                {"
    , "                    if next_slot == position_map.len() {"
    , "                        break;"
    , "                    }"
    , "                    let offset ="
    , "                        entry_index"
    , "                            .checked_mul(ORAM_LEAF_LABEL_BYTES)"
    , "                            .ok_or_else(|| {"
    , "                                anyhow!(\"ORAM position-map entry offset overflow for {}\", spec.name)"
    , "                            })?;"
    , "                    let value = read_u64_be_at("
    , "                        payload,"
    , "                        offset,"
    , "                        \"reading Path-ORAM position-map page entry\","
    , "                    )?;"
    , "                    let present = value != u64::MAX;"
    , "                    let masked_value = masked_select_u64(present, value, 0);"
    , "                    let leaf = usize::try_from(masked_value)"
    , "                        .map_err(|_| anyhow!(\"leaf label overflow for {}\", spec.name))?;"
    , "                    if present & (leaf >= parameters.leaf_count()) {"
    , "                        bail!("
    , "                            \"decoded ORAM position map for {} carries out-of-range leaf {}\","
    , "                            spec.name,"
    , "                            leaf"
    , "                        );"
    , "                    }"
    , "                    let target = position_map.get_mut(next_slot).ok_or_else(|| {"
    , "                        anyhow!("
    , "                            \"position map slot {} missing despite public capacity guard for {}\","
    , "                            next_slot,"
    , "                            spec.name"
    , "                        )"
    , "                    })?;"
    , "                    *target = MaskedUsizeOption::new(present, leaf);"
    , "                    if let Some(entries) = directory.as_deref_mut() {"
    , "                        let key_start = path_directory_keys_start() + entry_index * key_len;"
    , "                        let key = decode_scalar_value("
    , "                            key_type,"
    , "                            read_exact_range("
    , "                                payload,"
    , "                                key_start,"
    , "                                key_len,"
    , "                                \"reading ORAM directory key\","
    , "                            )?,"
    , "                        )?;"
    , "                        let key = Value::confidential_select(present, key, zero_key.clone())?;"
    , "                        let entry = entries.get_mut(next_slot).ok_or_else(|| {"
    , "                            anyhow!("
    , "                                \"directory slot {} missing despite public capacity guard for {}\","
    , "                                next_slot,"
    , "                                spec.name"
    , "                            )"
    , "                        })?;"
    , "                        entry.overwrite(present, key, zero_value.clone());"
    , "                    }"
    , "                    next_slot += 1;"
    , "                }"
    , "                Ok(())"
    , "            },"
    , "        )?;"
    , "    }"
    , "    if next_slot != position_map.len() {"
    , "        bail!("
    , "            \"decoded ORAM position map for {} produced {} entries, expected {}\","
    , "            spec.name,"
    , "            next_slot,"
    , "            position_map.len()"
    , "        );"
    , "    }"
    , "    Ok(())"
    , "}"
    , ""
    , "pub(super) fn serialize_oram_bucket_into("
    , "    bucket: &OramBucket,"
    , "    spec: &StateObject,"
    , "    out: &mut [u8],"
    , ") -> Result<()> {"
    , "    let parameters = OramParameters::for_spec(spec)?;"
    , "    if bucket.blocks.len() != parameters.blocks_per_bucket {"
    , "        bail!("
    , "            \"unexpected ORAM bucket block count for {}: {} != {}\","
    , "            spec.name,"
    , "            bucket.blocks.len(),"
    , "            parameters.blocks_per_bucket"
    , "        );"
    , "    }"
    , "    if out.len() != parameters.bucket_size {"
    , "        bail!("
    , "            \"unexpected ORAM bucket buffer length for {}: {} != {}\","
    , "            spec.name,"
    , "            out.len(),"
    , "            parameters.bucket_size"
    , "        );"
    , "    }"
    , "    let mut cursor = write_u64_be_at("
    , "        out,"
    , "        0,"
    , "        bucket.access_counter,"
    , "        \"writing ORAM bucket access counter\","
    , "    )?;"
    , "    cursor = write_u64_be_at("
    , "        out,"
    , "        cursor,"
    , "        u64::try_from(bucket.bucket_index)"
    , "            .map_err(|_| anyhow!(\"bucket index overflow for {}\", spec.name))?,"
    , "        \"writing ORAM bucket index\","
    , "    )?;"
    , "    cursor = write_u64_be_at("
    , "        out,"
    , "        cursor,"
    , "        u64::try_from(bucket.live_entry_count)"
    , "            .map_err(|_| anyhow!(\"live entry count overflow for {}\", spec.name))?,"
    , "        \"writing ORAM bucket live entry count\","
    , "    )?;"
    , "    for block in &bucket.blocks {"
    , "        let end = cursor + parameters.block_size;"
    , "        let target = out.get_mut(cursor..end).ok_or_else(|| {"
    , "            anyhow!("
    , "                \"ORAM bucket block range {}..{} missing despite exact bucket size for {}\","
    , "                cursor,"
    , "                end,"
    , "                spec.name"
    , "            )"
    , "        })?;"
    , "        serialize_oram_block_into(block, spec, target)?;"
    , "        cursor = end;"
    , "    }"
    , "    if cursor != out.len() {"
    , "        bail!("
    , "            \"serialized ORAM bucket length for {} drifted: {} != {}\","
    , "            spec.name,"
    , "            cursor,"
    , "            out.len()"
    , "        );"
    , "    }"
    , "    Ok(())"
    , "}"
    , ""
    , "pub(super) fn oram_bucket_bytes(bucket: &OramBucket, spec: &StateObject) -> Result<Box<[u8]>> {"
    , "    let parameters = OramParameters::for_spec(spec)?;"
    , "    let mut out = zeroed_boxed_bytes(parameters.bucket_size)?;"
    , "    serialize_oram_bucket_into(bucket, spec, &mut out)?;"
    , "    Ok(out)"
    , "}"
    , ""
    , "pub(super) fn deserialize_oram_bucket(spec: &StateObject, bytes: &[u8]) -> Result<OramBucket> {"
    , "    let parameters = OramParameters::for_spec(spec)?;"
    , "    if bytes.len() != parameters.bucket_size {"
    , "        bail!("
    , "            \"unexpected ORAM bucket length for {}: {} != {}\","
    , "            spec.name,"
    , "            bytes.len(),"
    , "            parameters.bucket_size"
    , "        );"
    , "    }"
    , "    let block_size = parameters.block_size;"
    , "    let access_counter = read_u64_be_at(bytes, 0, \"reading ORAM bucket access counter\")?;"
    , "    let bucket_index = usize::try_from(read_u64_be_at(bytes, 8, \"reading ORAM bucket index\")?)"
    , "        .map_err(|_| anyhow!(\"bucket index overflow for {}\", spec.name))?;"
    , "    let live_entry_count = usize::try_from(read_u64_be_at("
    , "        bytes,"
    , "        16,"
    , "        \"reading ORAM bucket live entry count\","
    , "    )?)"
    , "    .map_err(|_| anyhow!(\"live entry count overflow for {}\", spec.name))?;"
    , "    let empty_block = empty_oram_block(spec)?;"
    , "    let mut fixed_blocks = repeat_boxed_oram_blocks(parameters.blocks_per_bucket, &empty_block)?;"
    , "    let block_payload_len = parameters"
    , "        .bucket_size"
    , "        .checked_sub(ORAM_BUCKET_HEADER_BYTES)"
    , "        .ok_or_else(|| anyhow!(\"ORAM bucket header exceeds bucket size for {}\", spec.name))?;"
    , "    let block_payload = read_exact_range("
    , "        bytes,"
    , "        ORAM_BUCKET_HEADER_BYTES,"
    , "        block_payload_len,"
    , "        \"reading ORAM bucket block payload\","
    , "    )?;"
    , "    for (slot, block) in block_payload.chunks_exact(block_size).enumerate() {"
    , "        let target = fixed_blocks.get_mut(slot).ok_or_else(|| {"
    , "            anyhow!("
    , "                \"ORAM bucket decode slot {} missing despite exact public block count for {}\","
    , "                slot,"
    , "                spec.name"
    , "            )"
    , "        })?;"
    , "        *target = deserialize_oram_block(spec, block)?;"
    , "    }"
    , "    Ok(OramBucket {"
    , "        access_counter,"
    , "        bucket_index,"
    , "        live_entry_count,"
    , "        blocks: fixed_blocks,"
    , "    })"
    , "}"
    , ""
    , "pub(super) fn decode_bucket_payload<F>("
    , "    spec: &StateObject,"
    , "    expected_bucket_index: usize,"
    , "    bytes: &[u8],"
    , "    mut on_block: F,"
    , ") -> Result<()>"
    , "where"
    , "    F: FnMut(OramBlock) -> Result<()>,"
    , "{"
    , "    let parameters = OramParameters::for_spec(spec)?;"
    , "    if bytes.len() != parameters.bucket_size {"
    , "        bail!("
    , "            \"unexpected ORAM bucket length for {}: {} != {}\","
    , "            spec.name,"
    , "            bytes.len(),"
    , "            parameters.bucket_size"
    , "        );"
    , "    }"
    , "    let bucket_index = usize::try_from(read_u64_be_at("
    , "        bytes,"
    , "        8,"
    , "        \"reading ORAM bucket payload index\","
    , "    )?)"
    , "    .map_err(|_| anyhow!(\"bucket index overflow for {}\", spec.name))?;"
    , "    if bucket_index != expected_bucket_index {"
    , "        bail!("
    , "            \"decoded ORAM bucket header for {} claims index {} but storage location is {}\","
    , "            spec.name,"
    , "            bucket_index,"
    , "            expected_bucket_index"
    , "        );"
    , "    }"
    , "    let live_entry_count = usize::try_from(read_u64_be_at("
    , "        bytes,"
    , "        16,"
    , "        \"reading ORAM bucket payload live entry count\","
    , "    )?)"
    , "    .map_err(|_| anyhow!(\"live entry count overflow for {}\", spec.name))?;"
    , "    if live_entry_count > parameters.blocks_per_bucket {"
    , "        bail!("
    , "            \"decoded ORAM bucket {} for {} exceeds block budget {}\","
    , "            bucket_index,"
    , "            spec.name,"
    , "            parameters.blocks_per_bucket"
    , "        );"
    , "    }"
    , "    let mut occupied = 0usize;"
    , "    let block_payload_len = parameters"
    , "        .bucket_size"
    , "        .checked_sub(ORAM_BUCKET_HEADER_BYTES)"
    , "        .ok_or_else(|| anyhow!(\"ORAM bucket header exceeds bucket size for {}\", spec.name))?;"
    , "    let block_payload = read_exact_range("
    , "        bytes,"
    , "        ORAM_BUCKET_HEADER_BYTES,"
    , "        block_payload_len,"
    , "        \"reading decoded ORAM bucket payload blocks\","
    , "    )?;"
    , "    for block in block_payload.chunks_exact(parameters.block_size) {"
    , "        let block = deserialize_oram_block(spec, block)?;"
    , "        occupied += usize::from(block.occupied);"
    , "        on_block(block)?;"
    , "    }"
    , "    if occupied != live_entry_count {"
    , "        bail!("
    , "            \"decoded ORAM bucket {} for {} contains {} live blocks but header says {}\","
    , "            bucket_index,"
    , "            spec.name,"
    , "            occupied,"
    , "            live_entry_count"
    , "        );"
    , "    }"
    , "    Ok(())"
    , "}"
    , ""
    , "// ---------------------------------------------------------------------------"
    , "// Oblivious AVL map over Path ORAM"
    , "//"
    , "// A map whose entries are the nodes of an AVL tree, each node one Path ORAM"
    , "// block. A node stores its children's ids, leaves and subtree heights, so the"
    , "// position map recurses through the tree: the header holds the root's leaf"
    , "// and the free list's head, and every other node's leaf is in its parent (or,"
    , "// for a free node, in the previous free node). Every operation makes a fixed"
    , "// number of node accesses, `tree_get_accesses` for a get and"
    , "// `tree_put_accesses` for a put, each real (a node, read under its current"
    , "// leaf) or dummy (a fresh random leaf), and every choice is masked. A node"
    , "// access reads one path, takes its node out of the stash into the"
    , "// operation's cache, evicts the path and writes it back. Once its last access"
    , "// is done, the operation gives each node it read a fresh leaf (the coin of"
    , "// the access that read it), fixes the pointers to them, and returns them to"
    , "// the stash, so the stash holds up to `tree_put_accesses` nodes more than a"
    , "// Path ORAM stash between operations."
    , "// ---------------------------------------------------------------------------"
    , ""
    , "/// A pointer to a tree node: its id, the leaf it is stored under, and the"
    , "/// height of the subtree it roots. An absent pointer has height 0."
    , "#[derive(Debug, PartialEq, Eq)]"
    , "pub(crate) struct TreeLink {"
    , "    pub(super) present: bool,"
    , "    pub(super) id: usize,"
    , "    pub(super) leaf: usize,"
    , "    pub(super) height: usize,"
    , "}"
    , ""
    , "impl TreeLink {"
    , "    pub(super) fn none() -> Self {"
    , "        Self {"
    , "            present: false,"
    , "            id: 0,"
    , "            leaf: 0,"
    , "            height: 0,"
    , "        }"
    , "    }"
    , ""
    , "    pub(super) fn duplicate(&self) -> Self {"
    , "        Self {"
    , "            present: self.present,"
    , "            id: self.id,"
    , "            leaf: self.leaf,"
    , "            height: self.height,"
    , "        }"
    , "    }"
    , ""
    , "    pub(super) fn select(cond: bool, when_true: &Self, when_false: &Self) -> Self {"
    , "        Self {"
    , "            present: masked_select_bool(cond, when_true.present, when_false.present),"
    , "            id: masked_select_usize(cond, when_true.id, when_false.id),"
    , "            leaf: masked_select_usize(cond, when_true.leaf, when_false.leaf),"
    , "            height: masked_select_usize(cond, when_true.height, when_false.height),"
    , "        }"
    , "    }"
    , ""
    , "    fn points_to(&self, id: usize) -> bool {"
    , "        self.present & (self.id == id)"
    , "    }"
    , "}"
    , ""
    , "/// A tree node, or an empty block slot. A free node is not in the tree and"
    , "/// links the next free node through `left`."
    , "#[derive(Debug, PartialEq, Eq)]"
    , "pub(crate) struct TreeNode {"
    , "    pub(super) occupied: bool,"
    , "    pub(super) id: usize,"
    , "    pub(super) leaf: usize,"
    , "    pub(super) in_tree: bool,"
    , "    pub(super) key: Value,"
    , "    pub(super) value: Value,"
    , "    pub(super) left: TreeLink,"
    , "    pub(super) right: TreeLink,"
    , "}"
    , ""
    , "impl TreeNode {"
    , "    pub(super) fn empty(key_type: &Type, value_type: &Type) -> Self {"
    , "        Self {"
    , "            occupied: false,"
    , "            id: 0,"
    , "            leaf: 0,"
    , "            in_tree: false,"
    , "            key: Value::zero_for_type(key_type),"
    , "            value: Value::zero_for_type(value_type),"
    , "            left: TreeLink::none(),"
    , "            right: TreeLink::none(),"
    , "        }"
    , "    }"
    , ""
    , "    pub(super) fn height(&self) -> usize {"
    , "        1 + self.left.height.max(self.right.height)"
    , "    }"
    , ""
    , "    /// A pointer to this node, under its current leaf."
    , "    pub(super) fn link(&self) -> TreeLink {"
    , "        TreeLink {"
    , "            present: self.occupied,"
    , "            id: self.id,"
    , "            leaf: self.leaf,"
    , "            height: masked_select_usize(self.occupied, self.height(), 0),"
    , "        }"
    , "    }"
    , ""
    , "    pub(super) fn wipe_secrets(&mut self) {"
    , "        self.occupied = false;"
    , "        self.id = 0;"
    , "        self.leaf = 0;"
    , "        self.in_tree = false;"
    , "        self.key.wipe_secrets();"
    , "        self.value.wipe_secrets();"
    , "        self.left = TreeLink::none();"
    , "        self.right = TreeLink::none();"
    , "    }"
    , "}"
    , ""
    , "impl Drop for TreeNode {"
    , "    fn drop(&mut self) {"
    , "        self.wipe_secrets();"
    , "    }"
    , "}"
    , ""
    , "pub(super) fn clone_tree_node(node: &TreeNode) -> TreeNode {"
    , "    TreeNode {"
    , "        occupied: node.occupied,"
    , "        id: node.id,"
    , "        leaf: node.leaf,"
    , "        in_tree: node.in_tree,"
    , "        key: node.key.clone(),"
    , "        value: node.value.clone(),"
    , "        left: node.left.duplicate(),"
    , "        right: node.right.duplicate(),"
    , "    }"
    , "}"
    , ""
    , "pub(super) fn select_tree_node("
    , "    cond: bool,"
    , "    when_true: &TreeNode,"
    , "    when_false: &TreeNode,"
    , ") -> Result<TreeNode> {"
    , "    Ok(TreeNode {"
    , "        occupied: masked_select_bool(cond, when_true.occupied, when_false.occupied),"
    , "        id: masked_select_usize(cond, when_true.id, when_false.id),"
    , "        leaf: masked_select_usize(cond, when_true.leaf, when_false.leaf),"
    , "        in_tree: masked_select_bool(cond, when_true.in_tree, when_false.in_tree),"
    , "        key: Value::confidential_select(cond, when_true.key.clone(), when_false.key.clone())?,"
    , "        value: Value::confidential_select(cond, when_true.value.clone(), when_false.value.clone())?,"
    , "        left: TreeLink::select(cond, &when_true.left, &when_false.left),"
    , "        right: TreeLink::select(cond, &when_true.right, &when_false.right),"
    , "    })"
    , "}"
    , ""
    , "/// Overwrite `target` with `source` if `cond`, field by field."
    , "fn assign_tree_node(cond: bool, target: &mut TreeNode, source: &TreeNode) -> Result<()> {"
    , "    target.occupied = masked_select_bool(cond, source.occupied, target.occupied);"
    , "    target.id = masked_select_usize(cond, source.id, target.id);"
    , "    target.leaf = masked_select_usize(cond, source.leaf, target.leaf);"
    , "    target.in_tree = masked_select_bool(cond, source.in_tree, target.in_tree);"
    , "    let key = std::mem::replace(&mut target.key, Value::Bool(false));"
    , "    target.key = Value::confidential_select(cond, source.key.clone(), key)?;"
    , "    let value = std::mem::replace(&mut target.value, Value::Bool(false));"
    , "    target.value = Value::confidential_select(cond, source.value.clone(), value)?;"
    , "    target.left = TreeLink::select(cond, &source.left, &target.left);"
    , "    target.right = TreeLink::select(cond, &source.right, &target.right);"
    , "    Ok(())"
    , "}"
    , ""
    , "/// The tree's header: the root, the free list's head, and the number of keys."
    , "#[derive(Debug, PartialEq, Eq)]"
    , "pub(crate) struct TreeHeader {"
    , "    pub(super) root: TreeLink,"
    , "    pub(super) free: TreeLink,"
    , "    pub(super) size: usize,"
    , "}"
    , ""
    , "/// The public shape of a tree map."
    , "#[derive(Debug, PartialEq, Eq)]"
    , "pub(crate) struct TreeShape {"
    , "    pub(super) capacity: usize,"
    , "    pub(super) leaf_count: usize,"
    , "    pub(super) blocks_per_bucket: usize,"
    , "    pub(super) avl_height: usize,"
    , "    pub(super) stash_bound: usize,"
    , "    pub(super) key_type: Type,"
    , "    pub(super) value_type: Type,"
    , "    pub(super) key_width: usize,"
    , "}"
    , ""
    , "/// The largest height of an AVL tree of `capacity` nodes, counted in nodes:"
    , "/// the largest `h` whose smallest AVL tree, `F(h + 2) - 1` nodes, fits."
    , "pub(super) fn tree_avl_height(capacity: usize) -> usize {"
    , "    let mut fib_prev = 1usize; // F(h + 1)"
    , "    let mut fib = 2usize; // F(h + 2), from h = 1"
    , "    let mut height = 0usize;"
    , "    while fib - 1 <= capacity {"
    , "        height += 1;"
    , "        let next = fib + fib_prev;"
    , "        fib_prev = fib;"
    , "        fib = next;"
    , "    }"
    , "    height.max(1)"
    , "}"
    , ""
    , "pub(super) fn tree_get_accesses(avl_height: usize) -> usize {"
    , "    avl_height"
    , "}"
    , ""
    , "/// A put walks the tree (`avl_height` accesses), pops the free list (one),"
    , "/// and rebalances (two per level: a rotation's taller child and grandchild)."
    , "pub(super) fn tree_put_accesses(avl_height: usize) -> usize {"
    , "    3 * avl_height + 1"
    , "}"
    , ""
    , "/// The stash. Its first `persistent` slots hold the blocks kept between node"
    , "/// accesses. A node access appends the blocks of the path it reads at public"
    , "/// positions after them, takes out the node it wants, evicts the path, and"
    , "/// moves the appended blocks still in the stash into empty persistent slots."
    , "#[derive(Debug)]"
    , "pub(super) struct TreeStash {"
    , "    pub(super) blocks: Box<[TreeNode]>,"
    , "    pub(super) persistent: usize,"
    , "    pub(super) fill: usize,"
    , "    pub(super) empty: TreeNode,"
    , "}"
    , ""
    , "impl TreeStash {"
    , "    pub(super) fn with_capacity("
    , "        persistent: usize,"
    , "        capacity: usize,"
    , "        empty: &TreeNode,"
    , "    ) -> Result<Self> {"
    , "        if persistent > capacity {"
    , "            bail!("
    , "                \"tree stash persistent region {} exceeds capacity {}\","
    , "                persistent,"
    , "                capacity"
    , "            );"
    , "        }"
    , "        let mut blocks = FixedBoxBuilder::new(capacity);"
    , "        for _ in 0..capacity {"
    , "            blocks.push(clone_tree_node(empty))?;"
    , "        }"
    , "        Ok(Self {"
    , "            blocks: blocks.finish()?,"
    , "            persistent,"
    , "            fill: persistent,"
    , "            empty: clone_tree_node(empty),"
    , "        })"
    , "    }"
    , ""
    , "    /// The occupied blocks of the persistent stash."
    , "    pub(super) fn len(&self) -> usize {"
    , "        self.blocks"
    , "            .iter()"
    , "            .take(self.persistent)"
    , "            .fold(0usize, |acc, block| acc + usize::from(block.occupied))"
    , "    }"
    , ""
    , "    /// Append a block (occupied or not) at the next public position."
    , "    pub(super) fn append(&mut self, block: &TreeNode) -> Result<()> {"
    , "        let slot = self.blocks.get_mut(self.fill).ok_or_else(|| {"
    , "            anyhow!("
    , "                \"tree stash full at {} despite its public capacity\","
    , "                self.fill"
    , "            )"
    , "        })?;"
    , "        *slot = clone_tree_node(block);"
    , "        self.fill += 1;"
    , "        Ok(())"
    , "    }"
    , ""
    , "    /// Put a block in the first empty persistent slot if it is occupied;"
    , "    /// report whether an occupied block found no room."
    , "    pub(super) fn push_persistent(&mut self, block: &TreeNode) -> Result<bool> {"
    , "        let mut placed = false;"
    , "        for slot in self.blocks.iter_mut().take(self.persistent) {"
    , "            let here = block.occupied & !placed & !slot.occupied;"
    , "            assign_tree_node(here, slot, block)?;"
    , "            placed |= here;"
    , "        }"
    , "        Ok(block.occupied & !placed)"
    , "    }"
    , ""
    , "    /// Take out the block of node `id` if `want`; also count the blocks of"
    , "    /// that node, which must be exactly one."
    , "    pub(super) fn take(&mut self, id: usize, want: bool) -> Result<(TreeNode, usize)> {"
    , "        let mut taken = clone_tree_node(&self.empty);"
    , "        let mut count = 0usize;"
    , "        let fill = self.fill;"
    , "        for slot in self.blocks.iter_mut().take(fill) {"
    , "            let here = want & slot.occupied & (slot.id == id);"
    , "            assign_tree_node(here, &mut taken, slot)?;"
    , "            assign_tree_node(here, slot, &self.empty)?;"
    , "            count += usize::from(here);"
    , "        }"
    , "        Ok((taken, count))"
    , "    }"
    , ""
    , "    /// Fill bucket `index` with blocks whose paths pass through it, taking"
    , "    /// them out of the stash in stash order."
    , "    pub(super) fn evict_bucket("
    , "        &mut self,"
    , "        leaf_count: usize,"
    , "        index: usize,"
    , "        blocks_per_bucket: usize,"
    , "    ) -> Result<Box<[TreeNode]>> {"
    , "        let mut bucket = FixedBoxBuilder::new(blocks_per_bucket);"
    , "        for _ in 0..blocks_per_bucket {"
    , "            bucket.push(clone_tree_node(&self.empty))?;"
    , "        }"
    , "        let mut bucket = bucket.finish()?;"
    , "        let fill = self.fill;"
    , "        for candidate in self.blocks.iter_mut().take(fill) {"
    , "            let fits = candidate.occupied & bucket_on_leaf_path(leaf_count, index, candidate.leaf);"
    , "            let mut placed = false;"
    , "            for slot in bucket.iter_mut() {"
    , "                let here = fits & !placed & !slot.occupied;"
    , "                assign_tree_node(here, slot, candidate)?;"
    , "                placed |= here;"
    , "            }"
    , "            assign_tree_node(placed, candidate, &self.empty)?;"
    , "        }"
    , "        Ok(bucket)"
    , "    }"
    , ""
    , "    /// Move the appended blocks still occupied into empty persistent slots;"
    , "    /// report whether one found no room."
    , "    pub(super) fn compact(&mut self) -> Result<bool> {"
    , "        let persistent = self.persistent;"
    , "        let fill = self.fill;"
    , "        let mut overflowed = false;"
    , "        for source in persistent..fill {"
    , "            let moving = {"
    , "                let block = self"
    , "                    .blocks"
    , "                    .get(source)"
    , "                    .ok_or_else(|| anyhow!(\"tree stash slot {} missing\", source))?;"
    , "                clone_tree_node(block)"
    , "            };"
    , "            let mut placed = false;"
    , "            for slot in self.blocks.iter_mut().take(persistent) {"
    , "                let here = moving.occupied & !placed & !slot.occupied;"
    , "                assign_tree_node(here, slot, &moving)?;"
    , "                placed |= here;"
    , "            }"
    , "            overflowed |= moving.occupied & !placed;"
    , "            let source_slot = self"
    , "                .blocks"
    , "                .get_mut(source)"
    , "                .ok_or_else(|| anyhow!(\"tree stash slot {} missing\", source))?;"
    , "            *source_slot = clone_tree_node(&self.empty);"
    , "        }"
    , "        self.fill = persistent;"
    , "        Ok(overflowed)"
    , "    }"
    , "}"
    , ""
    , "/// Where a tree's buckets, header and stash live. Every node access reads"
    , "/// the access counter and one path and writes them back; an operation's"
    , "/// first access also reads the header and the stash, and the operation"
    , "/// writes them once its last access is done."
    , "pub(super) trait TreePathStore {"
    , "    /// A node access begins (`first`: the operation's first)."
    , "    fn begin_access(&mut self, first: bool) -> Result<()>;"
    , "    /// Move a bucket's blocks into the stash."
    , "    fn load_bucket(&mut self, index: usize, stash: &mut TreeStash) -> Result<()>;"
    , "    /// Replace a bucket's blocks."
    , "    fn store_bucket(&mut self, index: usize, blocks: &[TreeNode]) -> Result<()>;"
    , "    /// A node access ends."
    , "    fn end_access(&mut self) -> Result<()>;"
    , "    /// The operation ends with this header and stash."
    , "    fn end_operation(&mut self, header: &TreeHeader, stash: &TreeStash) -> Result<()>;"
    , "}"
    , ""
    , "/// The canonical big-endian bytes of a key, at the key type's width."
    , "fn tree_key_bytes(key: &Value, width: usize) -> Result<Box<[u8]>> {"
    , "    let mut out = zeroed_boxed_bytes(width)?;"
    , "    let mut cursor = 0usize;"
    , "    let mut overflowed = false;"
    , "    let mut copy_chunk = |chunk: &[u8]| {"
    , "        if overflowed {"
    , "            return;"
    , "        }"
    , "        match write_exact_range(&mut out, cursor, chunk, \"writing tree key bytes\") {"
    , "            Ok(end) => cursor = end,"
    , "            Err(_) => overflowed = true,"
    , "        }"
    , "    };"
    , "    key.visit_canonical_chunks(&mut copy_chunk);"
    , "    if overflowed || cursor != width {"
    , "        bail!(\"tree key encoding drifted from the key width {}\", width);"
    , "    }"
    , "    Ok(out)"
    , "}"
    , ""
    , "/// `lhs < rhs` in the keys' canonical order, without a secret branch."
    , "pub(super) fn tree_key_lt(lhs: &Value, rhs: &Value, width: usize) -> Result<bool> {"
    , "    let lhs_bytes = tree_key_bytes(lhs, width)?;"
    , "    let rhs_bytes = tree_key_bytes(rhs, width)?;"
    , "    let mut less = false;"
    , "    let mut decided = false;"
    , "    for (l, r) in lhs_bytes.iter().zip(rhs_bytes.iter()) {"
    , "        let byte_less = *l < *r;"
    , "        let byte_greater = *l > *r;"
    , "        less |= !decided & byte_less;"
    , "        decided |= byte_less | byte_greater;"
    , "    }"
    , "    Ok(less)"
    , "}"
    , ""
    , "/// The nodes one operation reads, one slot per access, with each access's"
    , "/// coin."
    , "struct TreeOpCache {"
    , "    slots: Box<[TreeNode]>,"
    , "    coins: Box<[usize]>,"
    , "    used: usize,"
    , "}"
    , ""
    , "impl TreeOpCache {"
    , "    fn new(accesses: usize, empty: &TreeNode) -> Result<Self> {"
    , "        let mut slots = FixedBoxBuilder::new(accesses);"
    , "        let mut coins = FixedBoxBuilder::new(accesses);"
    , "        for _ in 0..accesses {"
    , "            slots.push(clone_tree_node(empty))?;"
    , "            coins.push(0usize)?;"
    , "        }"
    , "        Ok(Self {"
    , "            slots: slots.finish()?,"
    , "            coins: coins.finish()?,"
    , "            used: 0,"
    , "        })"
    , "    }"
    , ""
    , "    fn contains(&self, link: &TreeLink) -> bool {"
    , "        let mut found = false;"
    , "        for slot in self.slots.iter().take(self.used) {"
    , "            found |= slot.occupied & link.points_to(slot.id);"
    , "        }"
    , "        found"
    , "    }"
    , ""
    , "    /// The node `id` if this operation read it (an empty node otherwise)."
    , "    fn find(&self, link: &TreeLink, empty: &TreeNode) -> Result<TreeNode> {"
    , "        let mut found = clone_tree_node(empty);"
    , "        for slot in self.slots.iter().take(self.used) {"
    , "            let here = slot.occupied & link.points_to(slot.id);"
    , "            assign_tree_node(here, &mut found, slot)?;"
    , "        }"
    , "        Ok(found)"
    , "    }"
    , ""
    , "    /// Write `node` back over this operation's copy of it, if `cond`."
    , "    fn store(&mut self, cond: bool, node: &TreeNode) -> Result<()> {"
    , "        let used = self.used;"
    , "        for slot in self.slots.iter_mut().take(used) {"
    , "            let here = cond & node.occupied & slot.occupied & (slot.id == node.id);"
    , "            assign_tree_node(here, slot, node)?;"
    , "        }"
    , "        Ok(())"
    , "    }"
    , "}"
    , ""
    , "fn load_tree_path<S: TreePathStore>("
    , "    shape: &TreeShape,"
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    leaf: usize,"
    , ") -> Result<()> {"
    , "    let mut result = Ok(());"
    , "    for_each_bucket_on_leaf_path_root_to_leaf(shape.leaf_count, leaf, |index| {"
    , "        if result.is_ok() {"
    , "            result = store.load_bucket(index, stash);"
    , "        }"
    , "    });"
    , "    result"
    , "}"
    , ""
    , "/// Evict the stash over the path of `leaf`, deepest bucket first, and write"
    , "/// each bucket as it is filled."
    , "fn evict_tree_path<S: TreePathStore>("
    , "    shape: &TreeShape,"
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    leaf: usize,"
    , ") -> Result<()> {"
    , "    let mut result = Ok(());"
    , "    for_each_bucket_on_leaf_path_leaf_to_root(shape.leaf_count, leaf, |index| {"
    , "        if result.is_err() {"
    , "            return;"
    , "        }"
    , "        result = stash"
    , "            .evict_bucket(shape.leaf_count, index, shape.blocks_per_bucket)"
    , "            .and_then(|blocks| store.store_bucket(index, &blocks));"
    , "    });"
    , "    result"
    , "}"
    , ""
    , "/// One node access: read the path of `link` if `want` and the operation has"
    , "/// not read the node yet, else the path of `coin`; take the node out of the"
    , "/// stash into the cache; evict the path and write it back. Returns the"
    , "/// node's cache slot and whether the access failed: the node was missing,"
    , "/// duplicated or under another leaf, or the stash overflowed."
    , "fn tree_access<S: TreePathStore>("
    , "    shape: &TreeShape,"
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    cache: &mut TreeOpCache,"
    , "    link: &TreeLink,"
    , "    want: bool,"
    , "    coin: usize,"
    , ") -> Result<(usize, bool)> {"
    , "    let slot = cache.used;"
    , "    if slot >= cache.slots.len() {"
    , "        bail!(\"tree operation made more accesses than its public schedule\");"
    , "    }"
    , "    store.begin_access(slot == 0)?;"
    , "    let real = want & link.present & !cache.contains(link);"
    , "    let read_leaf = masked_select_usize(real, link.leaf, coin);"
    , "    if read_leaf >= shape.leaf_count {"
    , "        bail!("
    , "            \"tree access leaf {} outside leaf count {}\","
    , "            read_leaf,"
    , "            shape.leaf_count"
    , "        );"
    , "    }"
    , "    load_tree_path(shape, store, stash, read_leaf)?;"
    , "    let (node, count) = stash.take(link.id, real)?;"
    , "    let failed = real & ((count != 1) | (node.leaf != link.leaf));"
    , "    evict_tree_path(shape, store, stash, read_leaf)?;"
    , "    let overflowed = stash.compact()?;"
    , "    store.end_access()?;"
    , "    let target = cache"
    , "        .slots"
    , "        .get_mut(slot)"
    , "        .ok_or_else(|| anyhow!(\"tree cache slot {} missing despite public bound\", slot))?;"
    , "    *target = node;"
    , "    *cache"
    , "        .coins"
    , "        .get_mut(slot)"
    , "        .ok_or_else(|| anyhow!(\"tree coin slot {} missing despite public bound\", slot))? = coin;"
    , "    cache.used += 1;"
    , "    Ok((slot, failed | overflowed))"
    , "}"
    , ""
    , "/// The node behind `link` for this operation: read it if `want` (a dummy"
    , "/// access otherwise, or when the operation already holds it), and return the"
    , "/// operation's copy of it."
    , "fn tree_fetch<S: TreePathStore>("
    , "    shape: &TreeShape,"
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    cache: &mut TreeOpCache,"
    , "    link: &TreeLink,"
    , "    want: bool,"
    , "    coin: usize,"
    , ") -> Result<(TreeNode, bool)> {"
    , "    let (_, failed) = tree_access(shape, store, stash, cache, link, want, coin)?;"
    , "    let wanted = TreeLink::select(want, link, &TreeLink::none());"
    , "    Ok((cache.find(&wanted, &stash.empty)?, failed))"
    , "}"
    , ""
    , "/// Give every node the operation read a fresh leaf (its access's coin), point"
    , "/// every pointer to it at that leaf, and return the nodes to the stash."
    , "/// Returns whether the stash overflowed."
    , "fn tree_finish<S: TreePathStore>("
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    header: &mut TreeHeader,"
    , "    cache: &mut TreeOpCache,"
    , ") -> Result<bool> {"
    , "    let used = cache.used;"
    , "    for target in 0..used {"
    , "        for source in 0..used {"
    , "            let (source_id, source_occupied, source_coin) = {"
    , "                let node = cache"
    , "                    .slots"
    , "                    .get(source)"
    , "                    .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", source))?;"
    , "                ("
    , "                    node.id,"
    , "                    node.occupied,"
    , "                    cache.coins.get(source).copied().unwrap_or(0),"
    , "                )"
    , "            };"
    , "            let node = cache"
    , "                .slots"
    , "                .get_mut(target)"
    , "                .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", target))?;"
    , "            let left_hit = source_occupied & node.left.points_to(source_id);"
    , "            node.left.leaf = masked_select_usize(left_hit, source_coin, node.left.leaf);"
    , "            let right_hit = source_occupied & node.right.points_to(source_id);"
    , "            node.right.leaf = masked_select_usize(right_hit, source_coin, node.right.leaf);"
    , "        }"
    , "    }"
    , "    let mut overflowed = false;"
    , "    for slot in 0..used {"
    , "        let coin = *cache"
    , "            .coins"
    , "            .get(slot)"
    , "            .ok_or_else(|| anyhow!(\"tree coin slot {} missing\", slot))?;"
    , "        let node = cache"
    , "            .slots"
    , "            .get_mut(slot)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", slot))?;"
    , "        let root_hit = node.occupied & header.root.points_to(node.id);"
    , "        header.root.leaf = masked_select_usize(root_hit, coin, header.root.leaf);"
    , "        let free_hit = node.occupied & header.free.points_to(node.id);"
    , "        header.free.leaf = masked_select_usize(free_hit, coin, header.free.leaf);"
    , "        node.leaf = masked_select_usize(node.occupied, coin, node.leaf);"
    , "        overflowed |= stash.push_persistent(node)?;"
    , "    }"
    , "    store.end_operation(header, stash)?;"
    , "    Ok(overflowed)"
    , "}"
    , ""
    , "/// Read the value of `key`: walk `avl_height` levels from the root, a dummy"
    , "/// access once the walk has found the key or fallen off the tree."
    , "pub(super) fn tree_get<S: TreePathStore, C: FnMut() -> Result<usize>>("
    , "    shape: &TreeShape,"
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    header: &mut TreeHeader,"
    , "    key: &Value,"
    , "    coins: &mut C,"
    , ") -> Result<(Value, bool)> {"
    , "    let accesses = tree_get_accesses(shape.avl_height);"
    , "    let mut cache = TreeOpCache::new(accesses, &stash.empty)?;"
    , "    let mut current = header.root.duplicate();"
    , "    let mut active = current.present;"
    , "    let mut value = Value::zero_for_type(&shape.value_type);"
    , "    let mut failed = false;"
    , "    for _ in 0..accesses {"
    , "        let coin = coins()?;"
    , "        let (slot, access_failed) ="
    , "            tree_access(shape, store, stash, &mut cache, &current, active, coin)?;"
    , "        failed |= access_failed;"
    , "        let node = cache"
    , "            .slots"
    , "            .get(slot)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", slot))?;"
    , "        let real = node.occupied & active;"
    , "        let found = real & Value::confidential_eq(&node.key, key);"
    , "        let less = real & tree_key_lt(key, &node.key, shape.key_width)?;"
    , "        value = Value::confidential_select(found, node.value.clone(), value)?;"
    , "        let next = TreeLink::select(less, &node.left, &node.right);"
    , "        active = real & !found & next.present;"
    , "        current = TreeLink::select(active, &next, &TreeLink::none());"
    , "    }"
    , "    failed |= tree_finish(store, stash, header, &mut cache)?;"
    , "    Ok((value, failed))"
    , "}"
    , ""
    , "/// Write `value` to `key` if `apply`: an insert, an update, or a delete when"
    , "/// `value` is zero. Every put makes `tree_put_accesses` accesses. Returns"
    , "/// whether an insert found the map full (the call aborts, and nothing"
    , "/// changes) and whether an access found the stored tree wrong."
    , "pub(super) fn tree_put<S: TreePathStore, C: FnMut() -> Result<usize>>("
    , "    shape: &TreeShape,"
    , "    store: &mut S,"
    , "    stash: &mut TreeStash,"
    , "    header: &mut TreeHeader,"
    , "    key: &Value,"
    , "    value: &Value,"
    , "    apply: bool,"
    , "    coins: &mut C,"
    , ") -> Result<(bool, bool)> {"
    , "    let height = shape.avl_height;"
    , "    let accesses = tree_put_accesses(height);"
    , "    let mut cache = TreeOpCache::new(accesses, &stash.empty)?;"
    , "    let value_is_zero = value.confidential_is_zero_like();"
    , "    let delete_request = apply & value_is_zero;"
    , "    let mut failed = false;"
    , ""
    , "    // Walk: slot `level` holds the level's node; `go_left[level]` is the"
    , "    // direction taken from it. A delete of a node with two children goes on"
    , "    // to its successor, the leftmost node of its right subtree."
    , "    let mut go_left = FixedBoxBuilder::new(height);"
    , "    let mut current = header.root.duplicate();"
    , "    let mut active = current.present;"
    , "    let mut successor_mode = false;"
    , "    let mut found = false;"
    , "    let mut found_level = 0usize;"
    , "    let mut found_two_children = false;"
    , "    let mut depth = 0usize;"
    , "    for level in 0..height {"
    , "        let coin = coins()?;"
    , "        let (slot, access_failed) ="
    , "            tree_access(shape, store, stash, &mut cache, &current, active, coin)?;"
    , "        failed |= access_failed;"
    , "        let node = cache"
    , "            .slots"
    , "            .get(slot)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", slot))?;"
    , "        let real = node.occupied & active;"
    , "        let searching = real & !successor_mode;"
    , "        let equal = searching & Value::confidential_eq(&node.key, key);"
    , "        let less = searching & !equal & tree_key_lt(key, &node.key, shape.key_width)?;"
    , "        let greater = searching & !equal & !less;"
    , "        let two_children = node.left.present & node.right.present;"
    , "        let start_successor = equal & delete_request & two_children;"
    , "        let continue_successor = real & successor_mode;"
    , "        let left = less | continue_successor;"
    , "        let right = greater | start_successor;"
    , "        go_left.push(left)?;"
    , "        found_level = masked_select_usize(equal, level, found_level);"
    , "        found_two_children = masked_select_bool(equal, two_children, found_two_children);"
    , "        found |= equal;"
    , "        depth += usize::from(real);"
    , "        let next = TreeLink::select(left, &node.left, &node.right);"
    , "        active = (left | right) & next.present;"
    , "        current = TreeLink::select(active, &next, &TreeLink::none());"
    , "        successor_mode |= start_successor;"
    , "    }"
    , "    let go_left = go_left.finish()?;"
    , ""
    , "    let insert = apply & !found & !value_is_zero & (header.size < shape.capacity);"
    , "    let overflow = apply & !found & !value_is_zero & (header.size >= shape.capacity);"
    , "    let update = apply & found & !value_is_zero;"
    , "    let delete = apply & found & value_is_zero;"
    , "    let changed = insert | delete;"
    , ""
    , "    // Pop the free list for an insert."
    , "    let free_head = header.free.duplicate();"
    , "    let coin = coins()?;"
    , "    let (free_slot, access_failed) ="
    , "        tree_access(shape, store, stash, &mut cache, &free_head, insert, coin)?;"
    , "    failed |= access_failed;"
    , "    let mut new_node = {"
    , "        let node = cache"
    , "            .slots"
    , "            .get(free_slot)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", free_slot))?;"
    , "        clone_tree_node(node)"
    , "    };"
    , "    let next_free = new_node.left.duplicate();"
    , "    header.free = TreeLink::select(insert, &next_free, &header.free);"
    , "    new_node.in_tree = masked_select_bool(insert, true, new_node.in_tree);"
    , "    new_node.key = Value::confidential_select(insert, key.clone(), new_node.key.clone())?;"
    , "    new_node.value = Value::confidential_select(insert, value.clone(), new_node.value.clone())?;"
    , "    new_node.left = TreeLink::select(insert, &TreeLink::none(), &new_node.left);"
    , "    new_node.right = TreeLink::select(insert, &TreeLink::none(), &new_node.right);"
    , "    cache.store(insert, &new_node)?;"
    , "    header.size = header.size.saturating_add(usize::from(insert));"
    , ""
    , "    // The structural change. `start_plus_one` is one more than the deepest"
    , "    // level whose child pointer changes (0: the root pointer itself), and"
    , "    // `sub` the subtree that pointer now names."
    , "    let mut sub = TreeLink::select(insert, &new_node.link(), &TreeLink::none());"
    , "    let mut start_plus_one = masked_select_usize(insert, depth, 0);"
    , ""
    , "    // An update rewrites the found node's value."
    , "    for level in 0..height {"
    , "        let hit = update & (level == found_level);"
    , "        let node = cache"
    , "            .slots"
    , "            .get_mut(level)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", level))?;"
    , "        node.value = Value::confidential_select(hit, value.clone(), node.value.clone())?;"
    , "    }"
    , ""
    , "    // A delete removes the found node, or, when it has two children, moves"
    , "    // the successor's entry into it and removes the successor."
    , "    let delete_two = delete & found_two_children;"
    , "    let delete_one = delete & !found_two_children;"
    , "    let successor_level = depth.saturating_sub(1);"
    , "    let removed_level = masked_select_usize(delete_two, successor_level, found_level);"
    , "    let mut successor_key = Value::zero_for_type(&shape.key_type);"
    , "    let mut successor_value = Value::zero_for_type(&shape.value_type);"
    , "    let mut successor_right = TreeLink::none();"
    , "    let mut found_left = TreeLink::none();"
    , "    let mut found_right = TreeLink::none();"
    , "    for level in 0..height {"
    , "        let node = cache"
    , "            .slots"
    , "            .get(level)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", level))?;"
    , "        let at_successor = delete_two & (level == successor_level);"
    , "        successor_key = Value::confidential_select(at_successor, node.key.clone(), successor_key)?;"
    , "        successor_value ="
    , "            Value::confidential_select(at_successor, node.value.clone(), successor_value)?;"
    , "        successor_right = TreeLink::select(at_successor, &node.right, &successor_right);"
    , "        let at_found = delete & (level == found_level);"
    , "        found_left = TreeLink::select(at_found, &node.left, &found_left);"
    , "        found_right = TreeLink::select(at_found, &node.right, &found_right);"
    , "    }"
    , "    let old_free = header.free.duplicate();"
    , "    let mut freed = TreeLink::none();"
    , "    for level in 0..height {"
    , "        let node = cache"
    , "            .slots"
    , "            .get_mut(level)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", level))?;"
    , "        let take_entry = delete_two & (level == found_level);"
    , "        node.key = Value::confidential_select(take_entry, successor_key.clone(), node.key.clone())?;"
    , "        node.value ="
    , "            Value::confidential_select(take_entry, successor_value.clone(), node.value.clone())?;"
    , "        let remove = delete & (level == removed_level);"
    , "        freed = TreeLink::select(remove, &node.link(), &freed);"
    , "        node.in_tree = masked_select_bool(remove, false, node.in_tree);"
    , "        node.key = Value::confidential_select("
    , "            remove,"
    , "            Value::zero_for_type(&shape.key_type),"
    , "            node.key.clone(),"
    , "        )?;"
    , "        node.value = Value::confidential_select("
    , "            remove,"
    , "            Value::zero_for_type(&shape.value_type),"
    , "            node.value.clone(),"
    , "        )?;"
    , "        node.left = TreeLink::select(remove, &old_free, &node.left);"
    , "        node.right = TreeLink::select(remove, &TreeLink::none(), &node.right);"
    , "    }"
    , "    freed.height = 0;"
    , "    header.free = TreeLink::select(delete, &freed, &header.free);"
    , "    header.size = header.size.saturating_sub(usize::from(delete));"
    , "    let one_child = TreeLink::select(found_left.present, &found_left, &found_right);"
    , "    sub = TreeLink::select(delete_two, &successor_right, &sub);"
    , "    sub = TreeLink::select(delete_one, &one_child, &sub);"
    , "    start_plus_one = masked_select_usize(delete_two, depth.saturating_sub(1), start_plus_one);"
    , "    start_plus_one = masked_select_usize(delete_one, found_level, start_plus_one);"
    , ""
    , "    // Rebalance from the deepest changed level up to the root, two accesses"
    , "    // per level: the taller child of an unbalanced node and, for a double"
    , "    // rotation, that child's inner child."
    , "    for offset in 0..height {"
    , "        let level = height - 1 - offset;"
    , "        let active_level = changed & (level < start_plus_one);"
    , "        let mut parent = {"
    , "            let node = cache"
    , "                .slots"
    , "                .get(level)"
    , "                .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", level))?;"
    , "            clone_tree_node(node)"
    , "        };"
    , "        let step_left = *go_left"
    , "            .get(level)"
    , "            .ok_or_else(|| anyhow!(\"tree walk direction {} missing\", level))?;"
    , "        parent.left = TreeLink::select(active_level & step_left, &sub, &parent.left);"
    , "        parent.right = TreeLink::select(active_level & !step_left, &sub, &parent.right);"
    , "        let left_height = parent.left.height;"
    , "        let right_height = parent.right.height;"
    , "        let heavy_left = active_level & (left_height >= right_height + 2);"
    , "        let heavy_right = active_level & (right_height >= left_height + 2);"
    , "        let rotate = heavy_left | heavy_right;"
    , "        let child_link = TreeLink::select(heavy_left, &parent.left, &parent.right);"
    , "        let coin = coins()?;"
    , "        let (child, child_failed) ="
    , "            tree_fetch(shape, store, stash, &mut cache, &child_link, rotate, coin)?;"
    , "        failed |= child_failed;"
    , "        let child_leans_right = child.right.height > child.left.height;"
    , "        let child_leans_left = child.left.height > child.right.height;"
    , "        let double = (heavy_left & child_leans_right) | (heavy_right & child_leans_left);"
    , "        let grandchild_link = TreeLink::select(heavy_left, &child.right, &child.left);"
    , "        let coin = coins()?;"
    , "        let (grandchild, grandchild_failed) = tree_fetch("
    , "            shape,"
    , "            store,"
    , "            stash,"
    , "            &mut cache,"
    , "            &grandchild_link,"
    , "            double,"
    , "            coin,"
    , "        )?;"
    , "        failed |= grandchild_failed;"
    , ""
    , "        // Single rotations."
    , "        let single_right = heavy_left & !double;"
    , "        let single_left = heavy_right & !double;"
    , "        let mut a = clone_tree_node(&parent);"
    , "        let mut y = clone_tree_node(&child);"
    , "        let mut x = clone_tree_node(&grandchild);"
    , "        a.left = TreeLink::select(single_right, &child.right, &a.left);"
    , "        a.right = TreeLink::select(single_left, &child.left, &a.right);"
    , "        let a_after_single = a.link();"
    , "        y.right = TreeLink::select(single_right, &a_after_single, &y.right);"
    , "        y.left = TreeLink::select(single_left, &a_after_single, &y.left);"
    , "        // Double rotations."
    , "        let left_right = heavy_left & double;"
    , "        let right_left = heavy_right & double;"
    , "        y.right = TreeLink::select(left_right, &grandchild.left, &y.right);"
    , "        a.left = TreeLink::select(left_right, &grandchild.right, &a.left);"
    , "        y.left = TreeLink::select(right_left, &grandchild.right, &y.left);"
    , "        a.right = TreeLink::select(right_left, &grandchild.left, &a.right);"
    , "        let a_after_double = a.link();"
    , "        let y_after_double = y.link();"
    , "        x.left = TreeLink::select(left_right, &y_after_double, &x.left);"
    , "        x.right = TreeLink::select(left_right, &a_after_double, &x.right);"
    , "        x.right = TreeLink::select(right_left, &y_after_double, &x.right);"
    , "        x.left = TreeLink::select(right_left, &a_after_double, &x.left);"
    , ""
    , "        // Write the nodes back and name the new subtree root."
    , "        let parent_slot = cache"
    , "            .slots"
    , "            .get_mut(level)"
    , "            .ok_or_else(|| anyhow!(\"tree cache slot {} missing\", level))?;"
    , "        assign_tree_node(active_level, parent_slot, &a)?;"
    , "        cache.store(rotate, &y)?;"
    , "        cache.store(double, &x)?;"
    , "        let new_root = TreeLink::select("
    , "            double,"
    , "            &x.link(),"
    , "            &TreeLink::select(rotate, &y.link(), &a.link()),"
    , "        );"
    , "        sub = TreeLink::select(active_level, &new_root, &sub);"
    , "    }"
    , "    header.root = TreeLink::select(changed, &sub, &header.root);"
    , "    failed |= tree_finish(store, stash, header, &mut cache)?;"
    , "    Ok((overflow, failed))"
    , "}"
    , ""
    , "/// A fresh tree: no keys, every node on the free list in id order, each under"
    , "/// a fresh leaf."
    , "pub(super) fn tree_bootstrap_nodes<C: FnMut() -> Result<usize>>("
    , "    shape: &TreeShape,"
    , "    coins: &mut C,"
    , ") -> Result<(TreeHeader, Box<[TreeNode]>)> {"
    , "    let mut leaves = FixedBoxBuilder::new(shape.capacity);"
    , "    for _ in 0..shape.capacity {"
    , "        let leaf = coins()?;"
    , "        if leaf >= shape.leaf_count {"
    , "            bail!("
    , "                \"tree bootstrap leaf {} outside leaf count {}\","
    , "                leaf,"
    , "                shape.leaf_count"
    , "            );"
    , "        }"
    , "        leaves.push(leaf)?;"
    , "    }"
    , "    let leaves = leaves.finish()?;"
    , "    let mut nodes = FixedBoxBuilder::new(shape.capacity);"
    , "    for id in 0..shape.capacity {"
    , "        let mut node = TreeNode::empty(&shape.key_type, &shape.value_type);"
    , "        node.occupied = true;"
    , "        node.id = id;"
    , "        node.leaf = *leaves"
    , "            .get(id)"
    , "            .ok_or_else(|| anyhow!(\"tree bootstrap leaf {} missing\", id))?;"
    , "        if let Some(next_leaf) = leaves.get(id + 1) {"
    , "            node.left = TreeLink {"
    , "                present: true,"
    , "                id: id + 1,"
    , "                leaf: *next_leaf,"
    , "                height: 0,"
    , "            };"
    , "        }"
    , "        nodes.push(node)?;"
    , "    }"
    , "    let free = match leaves.first() {"
    , "        Some(leaf) => TreeLink {"
    , "            present: true,"
    , "            id: 0,"
    , "            leaf: *leaf,"
    , "            height: 0,"
    , "        },"
    , "        None => TreeLink::none(),"
    , "    };"
    , "    Ok(("
    , "        TreeHeader {"
    , "            root: TreeLink::none(),"
    , "            free,"
    , "            size: 0,"
    , "        },"
    , "        nodes.finish()?,"
    , "    ))"
    , "}"
    , ""
    , "/// Place bootstrap nodes: each in the deepest bucket on its path with room,"
    , "/// or in the stash. `buckets` holds `blocks_per_bucket` empty slots each."
    , "pub(super) fn tree_place_nodes("
    , "    shape: &TreeShape,"
    , "    nodes: &[TreeNode],"
    , "    buckets: &mut [Box<[TreeNode]>],"
    , "    stash: &mut TreeStash,"
    , ") -> Result<()> {"
    , "    let levels = levels_for_leaf_count(shape.leaf_count);"
    , "    for node in nodes.iter() {"
    , "        let mut placed = false;"
    , "        for offset in 0..levels {"
    , "            let depth = levels - 1 - offset;"
    , "            let index = path_bucket_at_depth(shape.leaf_count, node.leaf, depth);"
    , "            let bucket = buckets"
    , "                .get_mut(index)"
    , "                .ok_or_else(|| anyhow!(\"tree bootstrap bucket {} missing\", index))?;"
    , "            for slot in bucket.iter_mut() {"
    , "                let here = !placed & !slot.occupied;"
    , "                assign_tree_node(here, slot, node)?;"
    , "                placed |= here;"
    , "            }"
    , "        }"
    , "        let mut leftover = clone_tree_node(node);"
    , "        leftover.occupied = node.occupied & !placed;"
    , "        if stash.push_persistent(&leftover)? {"
    , "            bail!(\"tree bootstrap stash overflow\");"
    , "        }"
    , "    }"
    , "    Ok(())"
    , "}"
    ] ++ "\n"

end GenerateRuntimeOramCodecsRust
