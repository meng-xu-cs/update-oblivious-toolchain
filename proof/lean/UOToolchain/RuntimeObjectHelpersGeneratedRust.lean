    , "pub(super) fn update_small_map_entries_for_put("
    , "    entries: &mut [MapEntry],"
    , "    key: Value,"
    , "    value: Value,"
    , "    apply: bool,"
    , "    value_type: &Type,"
    , "    object_name: &str,"
    , ") -> Result<bool> {"
    , "    let value_is_zero = value.confidential_is_zero_like();"
    , "    let zero_value = Value::zero_for_type(value_type);"
    , "    // Find the key before writing, so that a vacant slot ahead of the"
    , "    // key's slot does not receive a second copy of a present key."
    , "    let mut key_present = false;"
    , "    for entry in entries.iter() {"
    , "        key_present |= entry.matches_key(&key);"
    , "    }"
    , "    let mut inserted_any = false;"
    , "    for entry in entries.iter_mut() {"
    , "        let was_occupied = entry.is_occupied();"
    , "        let key_match = was_occupied & Value::confidential_eq(entry.key(), &key);"
    , "        let delete_here = apply & key_match & value_is_zero;"
    , "        let insert_here = apply & !value_is_zero & !key_present & !inserted_any & !was_occupied;"
    , "        let write_here = apply & !value_is_zero & (key_match | insert_here);"
    , "        let prior_key = entry.key().clone();"
    , "        let prior_value = entry.value().clone();"
    , "        let next_key = Value::confidential_select(insert_here, key.clone(), prior_key)?;"
    , "        let selected_value = Value::confidential_select(write_here, value.clone(), prior_value)?;"
    , "        let next_value ="
    , "            Value::confidential_select(delete_here, zero_value.clone(), selected_value)?;"
    , "        let next_occupied = (was_occupied & !delete_here) | insert_here;"
    , "        entry.overwrite(next_occupied, next_key, next_value);"
    , "        inserted_any |= insert_here;"
    , "    }"
    , "    let capacity_overflowed = apply & !value_is_zero & !key_present & !inserted_any;"
    , "    let _ = object_name;"
    , "    Ok(capacity_overflowed)"
    , "}"
