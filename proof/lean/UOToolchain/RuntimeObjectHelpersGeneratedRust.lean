    , "pub(super) fn decode_map_record(spec: &StateObject, bytes: &[u8]) -> Result<MapEntry> {"
    , "    let key_type = spec"
    , "        .key_type"
    , "        .as_ref()"
    , "        .ok_or_else(|| anyhow!(\"map {} missing key type\", spec.name))?;"
    , "    let key_len = key_type.canonical_len();"
    , "    let value_len = spec.value_type.canonical_len();"
    , "    let expected_len = 1 + key_len + value_len;"
    , "    if bytes.len() != expected_len {"
    , "        bail!("
    , "            \"unexpected map record length for {}: {} != {}\","
    , "            spec.name,"
    , "            bytes.len(),"
    , "            expected_len"
    , "        );"
    , "    }"
    , "    let occupied_tag = *read_exact_range(bytes, 0, 1, \"reading map record tag\")?"
    , "        .first()"
    , "        .ok_or_else(|| anyhow!(\"map record tag missing for {}\", spec.name))?;"
    , "    let occupied = match occupied_tag {"
    , "        0x7d => true,"
    , "        0x53 => false,"
    , "        other => bail!(\"invalid map record tag {other:#x} for {}\", spec.name),"
    , "    };"
    , "    let key_start = 1usize;"
    , "    let value_start = key_start + key_len;"
    , "    let key = Value::decode_canonical("
    , "        key_type,"
    , "        read_exact_range(bytes, key_start, key_len, \"reading map record key\")?,"
    , "    )?;"
    , "    let value = Value::decode_canonical("
    , "        &spec.value_type,"
    , "        read_exact_range(bytes, value_start, value_len, \"reading map record value\")?,"
    , "    )?;"
    , "    Ok(MapEntry::new(occupied, key, value))"
    , "}"
