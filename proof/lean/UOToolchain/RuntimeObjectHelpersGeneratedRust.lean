import UOToolchain.RuntimeArrayAccessDiscipline
import UOToolchain.RuntimeSmallMapLookupDiscipline

open UOToolchain

namespace GenerateRuntimeObjectHelpersRust

def joinSep (sep : String) : List String → String
  | [] => ""
  | x :: xs => xs.foldl (fun acc part => acc ++ sep ++ part) x

def checkDisciplines : IO Unit := do
  let arrayParameters : RuntimeArrayAccessDiscipline.Parameters := { capacity := 4 }
  let arrayTrace :=
    (List.range arrayParameters.capacity).foldl
      (fun trace _ => RuntimeArrayAccessDiscipline.step trace)
      (RuntimeArrayAccessDiscipline.initialTrace arrayParameters)
  if arrayTrace.capacity == arrayParameters.capacity &&
      arrayTrace.index == arrayParameters.capacity &&
      arrayTrace.overflowed == false then
    pure ()
  else
    throw <| IO.userError "runtime array-access discipline sample no longer accepts a full public scan"
  let lookupParameters : RuntimeSmallMapLookupDiscipline.Parameters := { capacity := 5 }
  let lookupTrace :=
    (List.range lookupParameters.capacity).foldl
      (fun trace _ => RuntimeSmallMapLookupDiscipline.step trace false)
      (RuntimeSmallMapLookupDiscipline.initialTrace lookupParameters)
  if lookupTrace.capacity == lookupParameters.capacity &&
      lookupTrace.index == lookupParameters.capacity &&
      lookupTrace.overflowed == false then
    pure ()
  else
    throw <| IO.userError "runtime small-map lookup discipline sample no longer accepts a full public scan"

