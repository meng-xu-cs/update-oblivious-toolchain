    , "        if aborted || !may_write {"
    , "            for (entry, loaded) in entries.iter_mut().zip(loaded_entries.iter_mut()) {"
    , "                std::mem::swap(entry, loaded);"
    , "            }"
    , "        }"
    , "    }"
    , "    if may_write {"
    , "        for (index, entry) in entries.iter().enumerate() {"
    , "            seal_slot(index, entry)?;"
    , "        }"
    , "    }"
    , "    Ok(())"
