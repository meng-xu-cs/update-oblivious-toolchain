    , "pub(super) fn encode_map_record_into(entry: &MapEntry, out: &mut [u8]) -> Result<()> {"
    , "    let expected_len = 1 + entry.key().canonical_len() + entry.value().canonical_len();"
    , "    if out.len() != expected_len {"
    , "        bail!("
    , "            \"unexpected map record buffer length: {} != {}\","
    , "            out.len(),"
    , "            expected_len"
    , "        );"
    , "    }"
    , "    let mut cursor = write_exact_range("
    , "        out,"
    , "        0,"
    , "        &[masked_select_u8(entry.is_occupied(), 0x7d, 0x53)],"
    , "        \"writing map record tag\","
    , "    )?;"
    , "    let mut overflowed = false;"
    , "    let mut copy_chunk = |chunk: &[u8]| {"
    , "        if overflowed {"
    , "            overflowed = true;"
    , "            return;"
    , "        }"
    , "        match write_exact_range(out, cursor, chunk, \"writing map record canonical chunk\") {"
    , "            Ok(end) => cursor = end,"
    , "            Err(_) => overflowed = true,"
    , "        }"
    , "    };"
    , "    entry.key().visit_canonical_chunks(&mut copy_chunk);"
    , "    entry.value().visit_canonical_chunks(&mut copy_chunk);"
    , "    if overflowed || cursor != out.len() {"
    , "        bail!(\"map record canonical encoding drifted from exact output length\");"
    , "    }"
    , "    Ok(())"
    , "}"
    , ""
