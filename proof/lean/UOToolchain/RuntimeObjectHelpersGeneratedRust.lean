    , "pub(super) fn encode_oram_directory_page_into("
    , "    entries: &[MapEntry],"
    , "    empty_entry: &MapEntry,"
    , "    out: &mut [u8],"
    , ") -> Result<()> {"
    , "    let record_len = 1 + empty_entry.key().canonical_len() + empty_entry.value().canonical_len();"
    , "    let expected_len = ORAM_DIRECTORY_PAGE_ENTRIES * record_len;"
    , "    if out.len() != expected_len {"
    , "        bail!("
    , "            \"unexpected ORAM directory page buffer length: {} != {}\","
    , "            out.len(),"
    , "            expected_len"
    , "        );"
    , "    }"
    , "    for index in 0..ORAM_DIRECTORY_PAGE_ENTRIES {"
    , "        let entry = entries.get(index).unwrap_or(empty_entry);"
    , "        let start = index * record_len;"
    , "        let end = checked_end(start, record_len, \"writing ORAM directory record\")?;"
    , "        let target = out.get_mut(start..end).ok_or_else(|| {"
    , "            anyhow!("
    , "                \"ORAM directory record range {}..{} missing despite exact page size\","
    , "                start,"
    , "                end"
    , "            )"
    , "        })?;"
    , "        encode_map_record_into(entry, target)?;"
    , "    }"
    , "    Ok(())"
