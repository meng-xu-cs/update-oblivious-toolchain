    , "    for _ in 0..len {"
    , "        bytes.push(0u8)?;"
    , "    }"
    , "    let mut out = bytes.finish()?;"
    , "    encode_map_record_into(entry, &mut out)?;"
    , "    Ok(out)"
    , "}"
