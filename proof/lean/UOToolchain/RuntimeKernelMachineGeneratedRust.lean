import UOToolchain.RuntimeKernelMachineSchedule

open UOToolchain

namespace GenerateRuntimeKernelMachineRust

open RuntimeKernelMachineSchedule

def joinSep (sep : String) : List String → String
  | [] => ""
  | x :: xs => xs.foldl (fun acc part => acc ++ sep ++ part) x

def checkEffectSchedule
  (label : String)
  (effect : Effect)
  (expected : List Action) : IO Unit := do
  let actual := effectSchedule effect
  if actual == expected then
    pure ()
  else
    throw <| IO.userError s!"{label} schedule mismatch: expected {repr expected}, got {repr actual}"

def checkMethodSchedules : IO Unit := do
  checkEffectSchedule
    "cell_get"
    Effect.cellGet
    [ Action.recordOpcode "CellGet" true
    , Action.recordKernelOp
    , Action.objectStoreCall "cell_get"
    ]
  checkEffectSchedule
    "cell_set"
    Effect.cellSet
    [ Action.recordOpcode "CellSet" true
    , Action.recordKernelOp
    , Action.reserveValueScratch "value_len"
    , Action.objectStoreCall "cell_set"
    ]
  checkEffectSchedule
    "array_get"
    Effect.arrayGet
    [ Action.recordOpcode "ArrayGet" true
    , Action.recordKernelOp
    , Action.reserveValueScratch "32"
    , Action.objectStoreCall "array_get"
    ]
  checkEffectSchedule
    "array_set"
    Effect.arraySet
    [ Action.recordOpcode "ArraySet" true
    , Action.recordKernelOp
    , Action.reserveValueScratch "max(value_len, 32)"
    , Action.objectStoreCall "array_set"
    ]
  checkEffectSchedule
    "map_get"
    Effect.mapGet
    [ Action.recordOpcode "MapGet" true
    , Action.recordKernelOp
    , Action.reserveValueScratch "key_len"
    , Action.objectStoreCall "map_get"
    ]
  checkEffectSchedule
    "map_put"
    Effect.mapPut
    [ Action.recordOpcode "MapPut" true
    , Action.recordKernelOp
    , Action.reserveValueScratch "max(key_len, value_len)"
    , Action.objectStoreCall "map_put"
    ]
  checkEffectSchedule
    "commit_objects"
    Effect.commit
    [ Action.recordOpcode "Commit" false
    , Action.recordKernelOp
    , Action.objectStoreCall "commit_against"
    , Action.appendCommitSchedule
    ]
  checkEffectSchedule
    "finish_with_machine_witness"
    Effect.finish
    [ Action.recordOpcode "Wipe" false
    , Action.recordKernelOp
    , Action.wipeScratch ScratchRegion.value
    , Action.wipeScratch ScratchRegion.hash
    , Action.wipeScratch ScratchRegion.io
    , Action.finishSnapshot
    ]

def generatedRust : String :=
  joinSep "\n"
    [ "// @generated by proof/lean/GenerateRuntimeKernelMachineRust.lean; do not edit by hand."
    , "// Re-run `lake build generateRuntimeKernelMachineRust` and then `.lake/build/bin/generateRuntimeKernelMachineRust` from proof/lean."
    , ""
    , "use anyhow::Result;"
    , "use tiny_keccak::{Hasher, Keccak};"
    , "use uo_allocator::ScratchRegion;"
    , "use uo_core::{RuntimeKernelFinishBundle, RuntimeKernelMachineFinishWitness, Value};"
    , "use uo_precompiles::UoOpcode;"
    , ""
    , "use super::{RuntimeKernelMachine, RuntimeKernelObjectStore};"
    , ""
    , "impl RuntimeKernelMachine {"
    , "    pub fn cell_get<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        recorder: &mut S::Recorder,"
    , "        object_id: u32,"
    , "    ) -> Result<Value> {"
    , "        self.record_kernel_step(UoOpcode::CellGet, Some(object_id))?;"
    , "        store.cell_get(recorder, object_id)"
    , "    }"
    , ""
    , "    pub fn cell_set<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        recorder: &mut S::Recorder,"
    , "        object_id: u32,"
    , "        value: Value,"
    , "        predicate: Option<bool>,"
    , "    ) -> Result<()> {"
    , "        self.record_kernel_step(UoOpcode::CellSet, Some(object_id))?;"
    , "        let value_len = store.value_canonical_len(object_id)?;"
    , "        self.touch_value_scratch(value_len)?;"
    , "        store.cell_set(recorder, object_id, value, predicate)"
    , "    }"
    , ""
    , "    pub fn array_get<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        recorder: &mut S::Recorder,"
    , "        object_id: u32,"
    , "        index: usize,"
    , "    ) -> Result<Value> {"
    , "        self.record_kernel_step(UoOpcode::ArrayGet, Some(object_id))?;"
    , "        self.touch_value_scratch(32)?;"
    , "        store.array_get(recorder, object_id, index)"
    , "    }"
    , ""
    , "    pub fn array_set<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        recorder: &mut S::Recorder,"
    , "        object_id: u32,"
    , "        index: usize,"
    , "        value: Value,"
    , "        predicate: Option<bool>,"
    , "    ) -> Result<()> {"
    , "        self.record_kernel_step(UoOpcode::ArraySet, Some(object_id))?;"
    , "        let value_len = store.value_canonical_len(object_id)?;"
    , "        self.touch_value_scratch(value_len.max(32))?;"
    , "        store.array_set(recorder, object_id, index, value, predicate)"
    , "    }"
    , ""
    , "    pub fn map_get<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        recorder: &mut S::Recorder,"
    , "        object_id: u32,"
    , "        key: &Value,"
    , "    ) -> Result<(Value, bool)> {"
    , "        self.record_kernel_step(UoOpcode::MapGet, Some(object_id))?;"
    , "        let key_len = store.key_canonical_len(object_id)?;"
    , "        self.touch_value_scratch(key_len)?;"
    , "        store.map_get(recorder, object_id, key, &mut self.allocator)"
    , "    }"
    , ""
    , "    pub fn map_put<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        recorder: &mut S::Recorder,"
    , "        object_id: u32,"
    , "        key: Value,"
    , "        value: Value,"
    , "        predicate: Option<bool>,"
    , "    ) -> Result<bool> {"
    , "        self.record_kernel_step(UoOpcode::MapPut, Some(object_id))?;"
    , "        let key_len = store.key_canonical_len(object_id)?;"
    , "        let value_len = store.value_canonical_len(object_id)?;"
    , "        self.touch_value_scratch(key_len.max(value_len))?;"
    , "        store.map_put("
    , "            recorder,"
    , "            object_id,"
    , "            key,"
    , "            value,"
    , "            predicate,"
    , "            &mut self.allocator,"
    , "        )"
    , "    }"
    , ""
    , "    pub fn keccak256_values(&mut self, parts: Box<[Value]>) -> Result<Value> {"
    , "        let mut hasher = Keccak::v256();"
    , "        let mut parts = parts;"
    , "        for part in parts.iter_mut() {"
    , "            self.note_hash_bytes(self.max_hash_part_bytes)?;"
    , "            part.visit_canonical_chunks(&mut |chunk| hasher.update(chunk));"
    , "            part.wipe_secrets();"
    , "            self.wipe_hash_scratch();"
    , "        }"
    , "        let mut out = [0u8; 32];"
    , "        hasher.finalize(&mut out);"
    , "        Ok(Value::Bytes32(out))"
    , "    }"
    , ""
    , "    pub fn commit_objects<S: RuntimeKernelObjectStore>("
    , "        &mut self,"
    , "        store: &mut S,"
    , "        committed: &S::CommittedState,"
    , "        aborted: bool,"
    , "        recorder: &mut S::Recorder,"
    , "    ) -> Result<()> {"
    , "        self.record_kernel_step(UoOpcode::Commit, None)?;"
    , "        let committed_object_ids ="
    , "            store.commit_against(committed, aborted, recorder, &mut self.allocator)?;"
    , "        self.boundary"
    , "            .append_commit_object_schedule(committed_object_ids)?;"
    , "        Ok(())"
    , "    }"
    , ""
    , "    pub fn finish_with_machine_witness("
    , "        mut self,"
    , "        entrypoint_id: &str,"
    , "    ) -> Result<(RuntimeKernelMachineFinishWitness, RuntimeKernelFinishBundle)> {"
    , "        self.record_kernel_step(UoOpcode::Wipe, None)?;"
    , "        self.allocator.wipe_region(ScratchRegion::ValueScratch);"
    , "        self.allocator.wipe_region(ScratchRegion::HashScratch);"
    , "        self.allocator.wipe_region(ScratchRegion::IoScratch);"
    , "        let finish_snapshot = self"
    , "            .boundary"
    , "            .into_finish_snapshot(entrypoint_id.into(), self.allocator.finish()?);"
    , "        let runtime_kernel_machine_finish_witness = finish_snapshot.machine_finish_witness();"
    , "        let runtime_kernel_finish_bundle = finish_snapshot"
    , "            .into_finish_bundle()"
    , "            .map_err(anyhow::Error::from)?;"
    , "        Ok(("
    , "            runtime_kernel_machine_finish_witness,"
    , "            runtime_kernel_finish_bundle,"
    , "        ))"
    , "    }"
    , "}"
    , ""
    ]

end GenerateRuntimeKernelMachineRust
